/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : OD - Odontologia                                              ::
  ::  Object      : od.fn_report_agenda(...)                                      ::
  ::  UsedBy      : ad.report_get                                                 ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 17/11/2026                                                    ::
  ::  Change      : 17/11/2026 - relatorios por categoria e por marcador          ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Relatorios do grupo Agenda (a permissao ja foi checada por ad.report_get).
    Helper interno (sem grant).
      appointments   consultas que comecam no periodo, por situacao
      first_visit    primeira consulta do paciente (nenhuma anterior que nao
                     tenha sido cancelada)
      return_alerts  pacientes ativos com alerta de retorno no periodo e a
                     proxima consulta marcada (se houver)
      categories     consultas do periodo por categoria (sem categoria a parte)
      markers        consultas do periodo por marcador (uma consulta conta em
                     cada marcador que tiver)
  Input:
    p_nr_company, p_nr_branch, p_report, p_d0, p_d1 (datas), p_from, p_to
    (mesmo periodo no fuso da filial), p_prof (profissional ou null), p_limit
  Output: jsonb {"rows", "summary", "by_professional", "qt"}
*/
create or replace function od.fn_report_agenda(
  p_nr_company bigint,
  p_nr_branch  bigint,
  p_report     text,
  p_d0         date,
  p_d1         date,
  p_from       timestamptz,
  p_to         timestamptz,
  p_prof       bigint,
  p_limit      integer)
returns jsonb
language plpgsql
stable
set search_path = ''
as $$
declare
  _rows    jsonb;
  _summary jsonb;
  _byprof  jsonb := '[]'::jsonb;
  _qt      integer;
begin
  if p_report = 'appointments' then
    with base as (
      select a.dh_start, a.it_status, a.it_origin, a.nr_professional, pa.vc_name as vc_patient, pa.vc_mobile,
             pr.vc_name as vc_professional, pc.vc_name as vc_procedure
        from od.appointment a
        left join od.patient pa on pa.nr_company = a.nr_company and pa.nr_branch = a.nr_branch and pa.nr_patient = a.nr_patient
        left join od.professional pr on pr.nr_company = a.nr_company and pr.nr_branch = a.nr_branch
                                    and pr.nr_professional = a.nr_professional
        left join od.procedure pc on pc.nr_company = a.nr_company and pc.nr_branch = a.nr_branch
                                 and pc.nr_procedure = a.nr_procedure
       where a.nr_company = p_nr_company and a.nr_branch = p_nr_branch and a.it_type = 1
         and a.dh_start >= p_from and a.dh_start < p_to
         and (p_prof is null or a.nr_professional = p_prof)
    )
    select
      (select coalesce(jsonb_agg(jsonb_build_object('dh_start', b.dh_start, 'vc_patient', b.vc_patient,
                'vc_mobile', b.vc_mobile, 'vc_professional', b.vc_professional, 'vc_procedure', b.vc_procedure,
                'it_status', b.it_status, 'it_origin', b.it_origin) order by b.dh_start), '[]'::jsonb)
         from (select * from base order by dh_start limit p_limit) b),
      jsonb_build_object(
        'qt_total', count(*),
        'qt_confirmed', count(*) filter (where it_status = 2),
        'qt_done', count(*) filter (where it_status = 5),
        'qt_no_show', count(*) filter (where it_status = 7),
        'qt_cancelled', count(*) filter (where it_status = 90),
        'qt_online', count(*) filter (where it_origin = 2)),
      (select coalesce(jsonb_agg(jsonb_build_object('nr_professional', g.nr_professional, 'vc_professional', g.vc_professional,
                'qt_total', g.qt_total, 'qt_done', g.qt_done, 'qt_no_show', g.qt_no_show, 'qt_cancelled', g.qt_cancelled)
                order by g.vc_professional), '[]'::jsonb)
         from (select nr_professional, vc_professional, count(*) as qt_total,
                      count(*) filter (where it_status = 5) as qt_done,
                      count(*) filter (where it_status = 7) as qt_no_show,
                      count(*) filter (where it_status = 90) as qt_cancelled
                 from base group by nr_professional, vc_professional) g),
      count(*)
      into _rows, _summary, _byprof, _qt
      from base;

  elsif p_report = 'first_visit' then
    with base as (
      select a.dh_start, a.it_status, a.nr_professional, pa.vc_name as vc_patient, pa.vc_mobile, pa.it_source,
             pr.vc_name as vc_professional
        from od.appointment a
        join od.patient pa on pa.nr_company = a.nr_company and pa.nr_branch = a.nr_branch and pa.nr_patient = a.nr_patient
        left join od.professional pr on pr.nr_company = a.nr_company and pr.nr_branch = a.nr_branch
                                    and pr.nr_professional = a.nr_professional
       where a.nr_company = p_nr_company and a.nr_branch = p_nr_branch and a.it_type = 1 and a.it_status <> 90
         and a.dh_start >= p_from and a.dh_start < p_to
         and (p_prof is null or a.nr_professional = p_prof)
         and not exists (select 1 from od.appointment x
                          where x.nr_company = a.nr_company and x.nr_branch = a.nr_branch
                            and x.nr_patient = a.nr_patient and x.it_type = 1 and x.it_status <> 90
                            and (x.dh_start < a.dh_start
                                 or (x.dh_start = a.dh_start and x.nr_appointment < a.nr_appointment)))
    )
    select
      (select coalesce(jsonb_agg(jsonb_build_object('dh_start', b.dh_start, 'vc_patient', b.vc_patient,
                'vc_mobile', b.vc_mobile, 'vc_professional', b.vc_professional, 'it_status', b.it_status,
                'it_source', b.it_source) order by b.dh_start), '[]'::jsonb)
         from (select * from base order by dh_start limit p_limit) b),
      jsonb_build_object(
        'qt_first', count(*),
        'qt_done', count(*) filter (where it_status = 5),
        'qt_no_show', count(*) filter (where it_status = 7)),
      (select coalesce(jsonb_agg(jsonb_build_object('nr_professional', g.nr_professional, 'vc_professional', g.vc_professional,
                'qt_first', g.qt_first, 'qt_done', g.qt_done) order by g.vc_professional), '[]'::jsonb)
         from (select nr_professional, vc_professional, count(*) as qt_first,
                      count(*) filter (where it_status = 5) as qt_done
                 from base group by nr_professional, vc_professional) g),
      count(*)
      into _rows, _summary, _byprof, _qt
      from base;

  elsif p_report in ('categories', 'markers') then
    with appt as (
      select a.nr_company, a.nr_branch, a.nr_appointment, a.nr_category, a.it_status
        from od.appointment a
       where a.nr_company = p_nr_company and a.nr_branch = p_nr_branch and a.it_type = 1
         and a.dh_start >= p_from and a.dh_start < p_to
         and (p_prof is null or a.nr_professional = p_prof)
    ), base as (
      select c.vc_name, c.vc_color, x.it_status
        from appt x
        left join od.appointment_category c on c.nr_company = x.nr_company and c.nr_branch = x.nr_branch
                                           and c.nr_category = x.nr_category
       where p_report = 'categories'
      union all
      select k.vc_name, k.vc_color, x.it_status
        from appt x
        join od.appointment_tag t on t.nr_company = x.nr_company and t.nr_branch = x.nr_branch
                                 and t.nr_appointment = x.nr_appointment
        join od.appointment_marker k on k.nr_company = t.nr_company and k.nr_branch = t.nr_branch
                                    and k.nr_marker = t.nr_marker
       where p_report = 'markers'
    ), grp as (
      select vc_name, vc_color, count(*) as qt_total,
             count(*) filter (where it_status = 5) as qt_done,
             count(*) filter (where it_status = 7) as qt_no_show,
             count(*) filter (where it_status = 90) as qt_cancelled
        from base group by vc_name, vc_color
    )
    select
      (select coalesce(jsonb_agg(jsonb_build_object('vc_name', g.vc_name, 'vc_color', g.vc_color,
                'qt_total', g.qt_total, 'qt_done', g.qt_done, 'qt_no_show', g.qt_no_show,
                'qt_cancelled', g.qt_cancelled,
                'pc_total', round(100.0 * g.qt_total / nullif((select count(*) from appt), 0), 1))
                order by g.vc_name is null, g.qt_total desc, g.vc_name), '[]'::jsonb)
         from grp g),
      jsonb_build_object('qt_appointments', (select count(*) from appt),
                         'qt_groups', (select count(*) from grp where vc_name is not null)),
      (select count(*) from grp)
      into _rows, _summary, _qt;

  else /* return_alerts */
    with base as (
      select p.dt_return_alert, p.vc_return_alert, p.vc_name as vc_patient, p.vc_mobile,
             (select min(a.dh_start) from od.appointment a
               where a.nr_company = p.nr_company and a.nr_branch = p.nr_branch and a.nr_patient = p.nr_patient
                 and a.it_type = 1 and a.it_status not in (7, 90) and a.dh_start >= now()) as dh_next
        from od.patient p
       where p.nr_company = p_nr_company and p.nr_branch = p_nr_branch and p.it_status = 1
         and p.dt_return_alert between p_d0 and p_d1
    )
    select
      (select coalesce(jsonb_agg(jsonb_build_object('dt_return_alert', b.dt_return_alert, 'vc_patient', b.vc_patient,
                'vc_mobile', b.vc_mobile, 'vc_return_alert', b.vc_return_alert, 'dh_next', b.dh_next)
                order by b.dt_return_alert, b.vc_patient), '[]'::jsonb)
         from (select * from base order by dt_return_alert, vc_patient limit p_limit) b),
      jsonb_build_object('qt_patients', count(*), 'qt_scheduled', count(*) filter (where dh_next is not null)),
      count(*)
      into _rows, _summary, _qt
      from base;
  end if;

  return jsonb_build_object('rows', _rows, 'summary', _summary, 'by_professional', _byprof, 'qt', _qt);
end;
$$;

revoke all on function od.fn_report_agenda(bigint, bigint, text, date, date, timestamptz, timestamptz, bigint, integer)
  from public, anon, authenticated;
