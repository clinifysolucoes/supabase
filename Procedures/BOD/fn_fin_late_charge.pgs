/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : OD - Odontologia                                              ::
  ::  Object      : od.fn_fin_late_charge(bigint, bigint, numeric, date, date)    ::
  ::  UsedBy      : ad.fin_entry_settle, ad.fin_entry_list                        ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 06/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Multa e juros de uma conta a receber paga (ou consultada) depois do
    vencimento, pelas configuracoes da filial (od.branch_setting):
      multa = valor x pc_late_fee / 100 (uma vez, se houver atraso)
      juros = valor x pc_late_interest / 100 / 30 x dias de atraso (pro rata)
    Sem atraso, sem configuracao ou percentuais zerados: tudo zero.
    Helper interno (sem grant).
  Input:
    p_nr_company, p_nr_branch, p_vl_amount (valor da conta), p_dt_due
    (vencimento), p_dt_ref (data do pagamento ou hoje)
  Output: jsonb {"qt_days", "vl_fine", "vl_interest", "vl_total"}
*/
create or replace function od.fn_fin_late_charge(
  p_nr_company bigint,
  p_nr_branch  bigint,
  p_vl_amount  numeric,
  p_dt_due     date,
  p_dt_ref     date)
returns jsonb
language plpgsql
stable
set search_path = ''
as $$
declare
  _days     integer := greatest(coalesce(p_dt_ref - p_dt_due, 0), 0);
  _fee      numeric := 0;
  _interest numeric := 0;
  _vl_fine  numeric := 0;
  _vl_int   numeric := 0;
begin
  if _days > 0 then
    select s.pc_late_fee, s.pc_late_interest into _fee, _interest
      from od.branch_setting s
     where s.nr_company = p_nr_company and s.nr_branch = p_nr_branch;
    _vl_fine := round(p_vl_amount * coalesce(_fee, 0) / 100, 2);
    _vl_int  := round(p_vl_amount * coalesce(_interest, 0) / 100 / 30 * _days, 2);
  end if;
  return jsonb_build_object('qt_days', _days, 'vl_fine', _vl_fine, 'vl_interest', _vl_int,
                            'vl_total', _vl_fine + _vl_int);
end;
$$;

revoke all on function od.fn_fin_late_charge(bigint, bigint, numeric, date, date) from public, anon, authenticated;
