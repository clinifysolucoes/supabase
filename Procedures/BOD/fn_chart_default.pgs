/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : OD - Odontologia                                              ::
  ::  Object      : od.fn_chart_default(bigint, bigint, bigint)                   ::
  ::  UsedBy      : ad.chart_model_list                                           ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 13/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Cria os modelos de ficha prontos (Ortodontia, Endodontia, Implantodontia e
    Periodontia) na primeira vez que a filial abre as fichas; depois a clinica
    edita em Configuracoes. Nao faz nada se a filial ja tem algum modelo.
    Tipos de campo: 1 texto curto | 2 texto longo | 3 sim/nao | 4 escolha
    (opcoes separadas por |) | 5 numero | 6 data | 7 titulo de secao.
    Helper interno (sem grant).
  Input: p_nr_company, p_nr_branch, p_nr_user
  Output: integer (modelos criados)
*/
create or replace function od.fn_chart_default(
  p_nr_company bigint,
  p_nr_branch  bigint,
  p_nr_user    bigint)
returns integer
language plpgsql
set search_path = ''
as $$
begin
  if exists (select 1 from od.chart_model m where m.nr_company = p_nr_company and m.nr_branch = p_nr_branch) then
    return 0;
  end if;
  perform 1 from ad.branch b where b.nr_company = p_nr_company and b.nr_branch = p_nr_branch for update;
  if exists (select 1 from od.chart_model m where m.nr_company = p_nr_company and m.nr_branch = p_nr_branch) then
    return 0;
  end if;

  insert into od.chart_model (nr_company, nr_branch, nr_model, vc_name, id_per_tooth, nr_operator)
  values (p_nr_company, p_nr_branch, 1, 'Ortodontia', false, p_nr_user),
         (p_nr_company, p_nr_branch, 2, 'Endodontia', true, p_nr_user),
         (p_nr_company, p_nr_branch, 3, 'Implantodontia', true, p_nr_user),
         (p_nr_company, p_nr_branch, 4, 'Periodontia', false, p_nr_user);

  insert into od.chart_field (nr_company, nr_branch, nr_model, nr_field, vc_label, it_type, vc_options, vc_unit, nr_operator)
  select p_nr_company, p_nr_branch, f.model, f.ord, f.label, f.tp, f.opt, f.unit, p_nr_user
    from (values
      -- Ortodontia
      (1, 1,  'Diagnóstico', 7, null, null),
      (1, 2,  'Classe de Angle', 4, 'Classe I|Classe II divisão 1|Classe II divisão 2|Classe III', null),
      (1, 3,  'Perfil facial', 4, 'Reto|Convexo|Côncavo', null),
      (1, 4,  'Overjet', 5, null, 'mm'),
      (1, 5,  'Overbite', 5, null, 'mm'),
      (1, 6,  'Mordida cruzada', 4, 'Ausente|Anterior|Posterior unilateral|Posterior bilateral', null),
      (1, 7,  'Mordida aberta', 3, null, null),
      (1, 8,  'Apinhamento', 4, 'Ausente|Leve|Moderado|Severo', null),
      (1, 9,  'Linha média', 4, 'Coincidente|Desviada para a direita|Desviada para a esquerda', null),
      (1, 10, 'Hábitos (sucção, respiração bucal, deglutição atípica...)', 1, null, null),
      (1, 11, 'Plano de tratamento', 7, null, null),
      (1, 12, 'Aparelho', 4, 'Fixo metálico|Fixo estético|Autoligado|Alinhadores|Móvel|Contenção', null),
      (1, 13, 'Extrações indicadas', 1, null, null),
      (1, 14, 'Documentação ortodôntica solicitada', 3, null, null),
      (1, 15, 'Previsão de tratamento', 5, null, 'meses'),
      (1, 16, 'Observações', 2, null, null),
      -- Endodontia (por dente)
      (2, 1,  'Diagnóstico', 7, null, null),
      (2, 2,  'Dor', 4, 'Ausente|Provocada|Espontânea|Contínua|Pulsátil', null),
      (2, 3,  'Teste de frio', 4, 'Positivo|Negativo|Exacerbado|Prolongado', null),
      (2, 4,  'Percussão vertical', 4, 'Positiva|Negativa', null),
      (2, 5,  'Palpação', 4, 'Positiva|Negativa', null),
      (2, 6,  'Diagnóstico pulpar', 4, 'Polpa normal|Pulpite reversível|Pulpite irreversível sintomática|Pulpite irreversível assintomática|Necrose pulpar|Previamente tratado', null),
      (2, 7,  'Diagnóstico periapical', 4, 'Normal|Periodontite apical sintomática|Periodontite apical assintomática|Abscesso apical agudo|Abscesso apical crônico', null),
      (2, 8,  'Tratamento', 7, null, null),
      (2, 9,  'Procedimento', 4, 'Pulpotomia|Tratamento de canal|Retratamento|Cirurgia parendodôntica', null),
      (2, 10, 'Canais e comprimento de trabalho', 2, null, null),
      (2, 11, 'Instrumento final (lima memória)', 1, null, null),
      (2, 12, 'Técnica de obturação', 4, 'Condensação lateral|Termoplastificada|Cone único', null),
      (2, 13, 'Medicação intracanal', 1, null, null),
      (2, 14, 'Data da obturação', 6, null, null),
      (2, 15, 'Observações', 2, null, null),
      -- Implantodontia (por dente)
      (3, 1,  'Planejamento', 7, null, null),
      (3, 2,  'Tipo de osso', 4, 'Tipo I|Tipo II|Tipo III|Tipo IV', null),
      (3, 3,  'Tomografia avaliada', 3, null, null),
      (3, 4,  'Enxerto', 4, 'Não|Autógeno|Xenógeno|Alógeno|Sintético|Levantamento de seio', null),
      (3, 5,  'Cirurgia', 7, null, null),
      (3, 6,  'Marca / sistema', 1, null, null),
      (3, 7,  'Conexão', 4, 'Cone Morse|Hexágono externo|Hexágono interno', null),
      (3, 8,  'Diâmetro', 5, null, 'mm'),
      (3, 9,  'Comprimento', 5, null, 'mm'),
      (3, 10, 'Lote', 1, null, null),
      (3, 11, 'Torque de inserção', 5, null, 'N.cm'),
      (3, 12, 'Carga', 4, 'Imediata|Precoce|Tardia', null),
      (3, 13, 'Data da cirurgia', 6, null, null),
      (3, 14, 'Reabertura e prótese', 7, null, null),
      (3, 15, 'Data da reabertura', 6, null, null),
      (3, 16, 'Componente protético', 1, null, null),
      (3, 17, 'Observações', 2, null, null),
      -- Periodontia
      (4, 1,  'Avaliação', 7, null, null),
      (4, 2,  'Queixa periodontal', 2, null, null),
      (4, 3,  'Fumante', 3, null, null),
      (4, 4,  'Diabetes controlada', 3, null, null),
      (4, 5,  'Diagnóstico', 4, 'Saúde periodontal|Gengivite|Periodontite estágio I|Periodontite estágio II|Periodontite estágio III|Periodontite estágio IV', null),
      (4, 6,  'Grau', 4, 'Grau A|Grau B|Grau C', null),
      (4, 7,  'Extensão', 4, 'Localizada|Generalizada|Padrão molar-incisivo', null),
      (4, 8,  'Plano de tratamento', 2, null, null),
      (4, 9,  'Intervalo de manutenção', 5, null, 'meses'),
      (4, 10, 'Observações', 2, null, null)
    ) f(model, ord, label, tp, opt, unit);
  return 4;
end;
$$;

revoke all on function od.fn_chart_default(bigint, bigint, bigint) from public, anon, authenticated;
