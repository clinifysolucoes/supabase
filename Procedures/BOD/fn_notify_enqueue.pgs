/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : OD - Odontologia                                              ::
  ::  Object      : od.fn_notify_enqueue()                                        ::
  ::  UsedBy      : ad.notify_dispatch (CLAIM)                                    ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 12/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Poe na fila (od.notify_message) os alertas por e-mail e SMS devidos de
    todas as filiais com algum canal ligado. Roda a cada chamada do
    agendador; o indice unico impede repetir. Uma linha por canal:
      e-mail  paciente com e-mail valido (sem "nao possui e-mail")
      SMS     paciente com celular valido (55 + DDD + numero)
    Alertas (it_kind, mesmos codigos do WhatsApp):
      1 lembrete     consulta Agendado (nao confirmada) que comeca nas proximas
                     qt_reminder_hours horas; leva um token para o link de
                     confirmacao
      2 agendamento  consulta Agendado/Confirmado criada na ultima hora e futura
      4 retorno      dt_return_alert = hoje, a partir de qt_send_hour no fuso
                     da filial
    O texto vem do modelo da filial (od.fn_notify_render). Helper interno.
  Output: integer (mensagens enfileiradas)
*/
create or replace function od.fn_notify_enqueue()
returns integer
language plpgsql
set search_path = ''
as $$
declare
  _s     record;
  _now   timestamp;
  _today date;
  _n     integer := 0;
  _k     integer;
begin
  for _s in
    select w.*, b.vc_timezone, b.vc_name as vc_clinic
      from od.notify_setting w
      join ad.branch b on b.nr_company = w.nr_company and b.nr_branch = w.nr_branch
      join ad.company c on c.nr_company = w.nr_company
     where (w.id_email or w.id_sms)
       and b.it_status = 1 and not b.id_blocked and c.it_status = 1 and not c.id_blocked
  loop
    perform 1 from ad.branch b where b.nr_company = _s.nr_company and b.nr_branch = _s.nr_branch for update;
    _now   := now() at time zone _s.vc_timezone;
    _today := _now::date;

    with cand as (
      -- lembrete e agendamento
      select k.kind, a.nr_patient, a.nr_appointment, (a.dh_start at time zone _s.vc_timezone)::date as dt_ref,
             p.vc_email, p.id_no_email, p.vc_mobile,
             jsonb_build_object('nome', split_part(p.vc_name, ' ', 1), 'clinica', _s.vc_clinic,
                                'data', to_char(a.dh_start at time zone _s.vc_timezone, 'DD/MM'),
                                'hora', to_char(a.dh_start at time zone _s.vc_timezone, 'HH24:MI'),
                                'profissional', coalesce(pr.vc_name, '')) as vars
        from od.appointment a
        join od.patient p on p.nr_company = a.nr_company and p.nr_branch = a.nr_branch and p.nr_patient = a.nr_patient
        left join od.professional pr on pr.nr_company = a.nr_company and pr.nr_branch = a.nr_branch
                                    and pr.nr_professional = a.nr_professional
        cross join lateral (
          select 1 as kind
           where _s.id_reminder and a.it_status = 1 and not a.id_all_day
             and a.dh_start <= now() + make_interval(hours => _s.qt_reminder_hours)
          union all
          select 2
           where _s.id_booked and a.it_status in (1, 2) and a.dh_created > now() - interval '1 hour') k
       where a.nr_company = _s.nr_company and a.nr_branch = _s.nr_branch
         and a.it_type = 1 and a.dh_start > now()
      union all
      -- retorno
      select 4, p.nr_patient, null::bigint, _today, p.vc_email, p.id_no_email, p.vc_mobile,
             jsonb_build_object('nome', split_part(p.vc_name, ' ', 1), 'clinica', _s.vc_clinic,
                                'retorno', coalesce(p.vc_return_alert, ''))
        from od.patient p
       where _s.id_return and extract(hour from _now) >= _s.qt_send_hour
         and p.nr_company = _s.nr_company and p.nr_branch = _s.nr_branch and p.it_status = 1
         and p.dt_return_alert = _today
    ),
    porcanal as (
      select c.*, ch.channel,
             case ch.channel when 1 then lower(trim(c.vc_email)) else od.fn_whatsapp_phone(c.vc_mobile) end as vc_to
        from cand c
        cross join (select 1 as channel where _s.id_email union all select 2 where _s.id_sms) ch
    ),
    novo as (
      select x.* from porcanal x
       where x.vc_to is not null
         and (x.channel = 2 or (not coalesce(x.id_no_email, false) and ad.fn_email_is_valid(x.vc_to)))
         and not exists (select 1 from od.notify_message m
                          where m.nr_company = _s.nr_company and m.nr_branch = _s.nr_branch
                            and m.it_channel = x.channel and m.it_kind = x.kind
                            and coalesce(m.nr_appointment, 0) = coalesce(x.nr_appointment, 0)
                            and m.nr_patient = x.nr_patient and m.dt_ref = x.dt_ref)
    )
    insert into od.notify_message (nr_company, nr_branch, nr_message, it_channel, it_kind, nr_patient, nr_appointment,
                                   dt_ref, vc_to, vc_subject, tx_body, uu_token)
    select _s.nr_company, _s.nr_branch,
           (select coalesce(max(m.nr_message), 0) from od.notify_message m
             where m.nr_company = _s.nr_company and m.nr_branch = _s.nr_branch) + row_number() over (),
           n.channel, n.kind, n.nr_patient, n.nr_appointment, n.dt_ref, n.vc_to,
           case when n.channel = 1 then left(case n.kind
             when 1 then format('Lembrete: consulta em %s às %s - %s', n.vars ->> 'data', n.vars ->> 'hora', _s.vc_clinic)
             when 2 then format('Consulta agendada para %s às %s - %s', n.vars ->> 'data', n.vars ->> 'hora', _s.vc_clinic)
             else format('Hora do seu retorno - %s', _s.vc_clinic) end, 150) end,
           od.fn_notify_render(case n.kind when 1 then _s.vc_tpl_reminder when 2 then _s.vc_tpl_booked
                                           else _s.vc_tpl_return end, n.vars),
           case when n.kind = 1 then gen_random_uuid() end
      from novo n
    on conflict do nothing;
    get diagnostics _k = row_count;
    _n := _n + _k;
  end loop;
  return _n;
end;
$$;

revoke all on function od.fn_notify_enqueue() from public, anon, authenticated;
