/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : OD - Odontologia                                              ::
  ::  Object      : RLS policies de todas as tabelas do schema od                 ::
  ::  UsedBy      : PostgREST (toda leitura do app passa por aqui)                ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 14/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Regra central de acesso do negocio: a linha e visivel se (nr_company,
    nr_branch) esta entre as filiais acessiveis do usuario
    (private.fn_my_branches). Nunca reimplementar a regra em outra policy.
    Nao existe policy de INSERT/UPDATE/DELETE: toda escrita passa pelas RPCs
    SECURITY DEFINER do schema od, que checam a permissao por tela.
*/

-- od.pricing_param
drop policy if exists pricing_param_select on od.pricing_param;
create policy pricing_param_select on od.pricing_param
  for select to authenticated
  using ((nr_company, nr_branch) in (select mb.nr_company, mb.nr_branch from private.fn_my_branches() mb));

