/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.access_profile_save(jsonb)                                 ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('access_profile_save')   ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 13/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Manutencao de perfis de acesso da empresa. Somente administrador.
      vc_action = 'I'  cria perfil (nr_profile sequencial por empresa)
      vc_action = 'U'  atualiza nome / nivel / situacao (parcial)
    Guarda: a empresa nunca pode ficar sem um administrador ativo
    (ad.fn_company_has_admin) - a transacao inteira e desfeita.

  Input p_json:
    nr_version  integer  obrigatorio = 1
    vc_action   text     obrigatorio 'I' | 'U'
    nr_company  bigint   obrigatorio
    nr_profile  bigint   obrigatorio em 'U'
    vc_name     text     obrigatorio em 'I'; opcional em 'U' (ate 30)
    it_level    integer  0..100 (100 = administrador). Default 0 em 'I'
    it_status   integer  1 ativo | 90 inativo (so em 'U')

  Output jsonb: {"nr_company": 1, "nr_profile": 3}

  Errors: VERSION_MISMATCH, ACCESS_PROFILE_ACTION_INVALID, ACCESS_PROFILE_COMPANY_REQUIRED,
    ACCESS_PROFILE_FORBIDDEN, ACCESS_PROFILE_NAME_REQUIRED, ACCESS_PROFILE_NAME_IN_USE {Name},
    ACCESS_PROFILE_LEVEL_INVALID, ACCESS_PROFILE_REQUIRED, ACCESS_PROFILE_NOT_FOUND,
    ACCESS_PROFILE_STATUS_INVALID, ACCESS_PROFILE_LAST_ADMIN
*/

create or replace function ad.access_profile_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _vc_action  text;
  _nr_company bigint;
  _nr_profile bigint;
  _vc_name    varchar(30);
  _it_level   smallint;
  _it_status  smallint;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'access_profile_save');

  _vc_action := upper(coalesce(p_json ->> 'vc_action', ''));
  if _vc_action not in ('I', 'U') then
    raise exception '%', ad.fn_message('ACCESS_PROFILE_ACTION_INVALID');
  end if;

  _nr_company := (p_json ->> 'nr_company')::bigint;
  if _nr_company is null then
    raise exception '%', ad.fn_message('ACCESS_PROFILE_COMPANY_REQUIRED');
  end if;

  _nr_user := private.fn_current_user_nr();
  if _nr_user is null or not private.fn_is_company_admin(_nr_company) then
    raise exception '%', ad.fn_message('ACCESS_PROFILE_FORBIDDEN');
  end if;

  if p_json ? 'vc_name' or _vc_action = 'I' then
    _vc_name := left(nullif(trim(p_json ->> 'vc_name'), ''), 30);
    if _vc_name is null then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_NAME_REQUIRED');
    end if;
  end if;

  if p_json ? 'it_level' or _vc_action = 'I' then
    _it_level := coalesce((p_json ->> 'it_level')::smallint, 0);
    if _it_level not between 0 and 100 then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_LEVEL_INVALID');
    end if;
  end if;

  if p_json ? 'it_status' then
    _it_status := (p_json ->> 'it_status')::smallint;
    if _it_status not in (1, 90) then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_STATUS_INVALID');
    end if;
  end if;

  /*------------------------------------------------------------------------*/
  if _vc_action = 'I' then
  /*------------------------------------------------------------------------*/
    if exists (select 1 from ad.access_profile p
                where p.nr_company = _nr_company and lower(p.vc_name) = lower(_vc_name)) then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_NAME_IN_USE', jsonb_build_object('Name', _vc_name));
    end if;

    perform 1 from ad.company c where c.nr_company = _nr_company for update;

    select coalesce(max(p.nr_profile), 0) + 1
      into _nr_profile
      from ad.access_profile p
     where p.nr_company = _nr_company;

    insert into ad.access_profile (nr_company, nr_profile, vc_name, it_level, it_status, nr_operator)
    values (_nr_company, _nr_profile, _vc_name, _it_level, 1, _nr_user);

  /*------------------------------------------------------------------------*/
  else /* 'U' */
  /*------------------------------------------------------------------------*/
    _nr_profile := (p_json ->> 'nr_profile')::bigint;
    if _nr_profile is null then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_REQUIRED');
    end if;
    if not exists (select 1 from ad.access_profile p
                    where p.nr_company = _nr_company and p.nr_profile = _nr_profile) then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_NOT_FOUND');
    end if;
    if _vc_name is not null and exists (
         select 1 from ad.access_profile p
          where p.nr_company = _nr_company
            and lower(p.vc_name) = lower(_vc_name)
            and p.nr_profile <> _nr_profile) then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_NAME_IN_USE', jsonb_build_object('Name', _vc_name));
    end if;

    update ad.access_profile p set
      vc_name   = case when p_json ? 'vc_name'   then _vc_name   else p.vc_name end,
      it_level  = case when p_json ? 'it_level'  then _it_level  else p.it_level end,
      it_status = case when p_json ? 'it_status' then _it_status else p.it_status end
    where p.nr_company = _nr_company
      and p.nr_profile = _nr_profile;

    if not ad.fn_company_has_admin(_nr_company) then
      raise exception '%', ad.fn_message('ACCESS_PROFILE_LAST_ADMIN');
    end if;
  end if;

  return jsonb_build_object('nr_company', _nr_company, 'nr_profile', _nr_profile);
end;
$$;

revoke all on function ad.access_profile_save(jsonb) from public, anon;
grant execute on function ad.access_profile_save(jsonb) to authenticated;
