/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.fin_transfer_save(jsonb)                                   ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('fin_transfer_save')     ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 04/11/2026                                                    ::
  ::  Change      : 05/11/2026 - trava com extrato conciliado (fase 3b)          ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Movimento de dinheiro entre contas da filial (nao e receita nem despesa):
      I       cria (permissao CRIAR): it_type 1 transferencia | 2 sangria (sai
              do caixa para outra conta) | 3 suprimento (entra no caixa vindo
              de outra conta). Sangria exige a origem do tipo caixa e
              suprimento exige o destino do tipo caixa. Se a conta caixa
              tiver sessao aberta, o movimento entra no fechamento dela.
      CANCEL  cancela (permissao ALTERAR); nao vale se a sessao de caixa do
              movimento ja foi fechada.
    Grava ad.event_log.

  Input p_json:
    nr_version       integer  obrigatorio = 1
    nr_company       bigint   obrigatorio
    nr_branch        bigint   obrigatorio
    vc_action        text     obrigatorio I | CANCEL
    nr_transfer      bigint   CANCEL
    it_type          integer  I (padrao 1)
    nr_account_from  bigint   I
    nr_account_to    bigint   I
    vl_amount        numeric  I (> 0)
    dt_transfer      date     I (padrao hoje no fuso da filial)
    vc_description   text     I (opcional)

  Output jsonb: {"nr_transfer", "it_status", "nr_cash_session"}

  Errors: VERSION_MISMATCH, FINANCE_BRANCH_REQUIRED, FIN_TRANSFER_ACTION_INVALID, FIN_TRANSFER_FORBIDDEN,
    FIN_TRANSFER_VALUE_INVALID, FIN_TRANSFER_TYPE_INVALID, FIN_TRANSFER_ACCOUNT_INVALID,
    FIN_TRANSFER_SAME_ACCOUNT, FIN_TRANSFER_AMOUNT_INVALID, FIN_TRANSFER_REQUIRED, FIN_TRANSFER_NOT_FOUND,
    FIN_TRANSFER_STATUS_INVALID, FIN_CASH_SESSION_CLOSED, FIN_BANK_RECONCILED
*/
create or replace function ad.fin_transfer_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _action     text := upper(coalesce(p_json ->> 'vc_action', ''));
  _perm       jsonb;
  _nr         bigint;
  _type       smallint;
  _from       bigint;
  _to         bigint;
  _amount     numeric;
  _dt         date;
  _desc       text;
  _from_type  smallint;
  _to_type    smallint;
  _session    bigint;
  _cur        od.fin_transfer%rowtype;
  _tz         text;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'fin_transfer_save');

  if _action not in ('I', 'CANCEL') then
    raise exception '%', ad.fn_message('FIN_TRANSFER_ACTION_INVALID');
  end if;
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('FINANCE_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'FINANCE');
  if _nr_user is null
     or (_action = 'I' and not (_perm ->> 'id_create')::boolean)
     or (_action = 'CANCEL' and not (_perm ->> 'id_update')::boolean) then
    raise exception '%', ad.fn_message('FIN_TRANSFER_FORBIDDEN');
  end if;

  if _action = 'CANCEL' then
    _nr := (p_json ->> 'nr_transfer')::bigint;
    if _nr is null then
      raise exception '%', ad.fn_message('FIN_TRANSFER_REQUIRED');
    end if;
    select * into _cur from od.fin_transfer t
     where t.nr_company = _nr_company and t.nr_branch = _nr_branch and t.nr_transfer = _nr
       for update;
    if not found then
      raise exception '%', ad.fn_message('FIN_TRANSFER_NOT_FOUND');
    end if;
    if _cur.it_status <> 1 then
      raise exception '%', ad.fn_message('FIN_TRANSFER_STATUS_INVALID');
    end if;
    if exists (select 1 from od.fin_cash_session s
                where s.nr_company = _nr_company and s.nr_branch = _nr_branch
                  and s.nr_session = _cur.nr_cash_session and s.it_status = 2) then
      raise exception '%', ad.fn_message('FIN_CASH_SESSION_CLOSED');
    end if;
    if exists (select 1 from od.fin_bank_line l
                where l.nr_company = _nr_company and l.nr_branch = _nr_branch and l.nr_transfer = _nr) then
      raise exception '%', ad.fn_message('FIN_BANK_RECONCILED');
    end if;
    update od.fin_transfer t set it_status = 90
     where t.nr_company = _nr_company and t.nr_branch = _nr_branch and t.nr_transfer = _nr;
    perform ad.fn_event_log(
      _nr_user, _nr_company, _nr_branch, 'FINANCE', 'UPDATE',
      'fin_transfer', _nr_company::text || '/' || _nr_branch::text || '/' || _nr::text,
      'Movimento entre contas cancelado',
      jsonb_build_object('vl_amount', _cur.vl_amount, 'it_type', _cur.it_type));
    return jsonb_build_object('nr_transfer', _nr, 'it_status', 90, 'nr_cash_session', _cur.nr_cash_session);
  end if;

  begin
    _type   := coalesce((p_json ->> 'it_type')::smallint, 1);
    _from   := (p_json ->> 'nr_account_from')::bigint;
    _to     := (p_json ->> 'nr_account_to')::bigint;
    _amount := round((p_json ->> 'vl_amount')::numeric, 2);
    _dt     := (p_json ->> 'dt_transfer')::date;
    _desc   := left(nullif(trim(p_json ->> 'vc_description'), ''), 140);
  exception when others then
    raise exception '%', ad.fn_message('FIN_TRANSFER_VALUE_INVALID');
  end;
  if _type not in (1, 2, 3) then
    raise exception '%', ad.fn_message('FIN_TRANSFER_TYPE_INVALID');
  end if;
  select a.it_type into _from_type from od.fin_account a
   where a.nr_company = _nr_company and a.nr_branch = _nr_branch and a.nr_account = _from and a.it_status = 1;
  select a.it_type into _to_type from od.fin_account a
   where a.nr_company = _nr_company and a.nr_branch = _nr_branch and a.nr_account = _to and a.it_status = 1;
  if _from_type is null or _to_type is null
     or (_type = 2 and _from_type <> 1) or (_type = 3 and _to_type <> 1) then
    raise exception '%', ad.fn_message('FIN_TRANSFER_ACCOUNT_INVALID');
  end if;
  if _from = _to then
    raise exception '%', ad.fn_message('FIN_TRANSFER_SAME_ACCOUNT');
  end if;
  if _amount is null or _amount <= 0 then
    raise exception '%', ad.fn_message('FIN_TRANSFER_AMOUNT_INVALID');
  end if;
  if _dt is null then
    select b.vc_timezone into _tz from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch;
    _dt := (now() at time zone _tz)::date;
  end if;

  _session := case _type
                when 2 then od.fn_fin_open_session(_nr_company, _nr_branch, _from)
                when 3 then od.fn_fin_open_session(_nr_company, _nr_branch, _to)
                else coalesce(od.fn_fin_open_session(_nr_company, _nr_branch, _from),
                              od.fn_fin_open_session(_nr_company, _nr_branch, _to)) end;

  perform 1 from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch for update;
  select coalesce(max(t.nr_transfer), 0) + 1 into _nr
    from od.fin_transfer t where t.nr_company = _nr_company and t.nr_branch = _nr_branch;
  insert into od.fin_transfer (nr_company, nr_branch, nr_transfer, it_type, nr_account_from, nr_account_to,
                               vl_amount, dt_transfer, vc_description, nr_cash_session, nr_user_created, nr_operator)
  values (_nr_company, _nr_branch, _nr, _type, _from, _to, _amount, _dt,
          coalesce(_desc, case _type when 2 then 'Sangria' when 3 then 'Suprimento' else 'Transferência' end),
          _session, _nr_user, _nr_user);

  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'FINANCE', 'CREATE',
    'fin_transfer', _nr_company::text || '/' || _nr_branch::text || '/' || _nr::text,
    case _type when 2 then 'Sangria registrada' when 3 then 'Suprimento registrado'
               else 'Transferência entre contas registrada' end,
    jsonb_build_object('it_type', _type, 'nr_account_from', _from, 'nr_account_to', _to,
                       'vl_amount', _amount, 'dt_transfer', _dt));

  return jsonb_build_object('nr_transfer', _nr, 'it_status', 1, 'nr_cash_session', _session);
end;
$$;

revoke all on function ad.fin_transfer_save(jsonb) from public, anon;
grant execute on function ad.fin_transfer_save(jsonb) to authenticated;
