/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.price_table_list(jsonb)                                    ::
  ::  UsedBy      : Flutter -> rpc('price_table_list') (Precificacao, Orcamentos) ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 18/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Tabelas de preco particulares da filial com os precos de cada
    procedimento. Exige LER em PRICING ou em BUDGETS (o orcamento escolhe a
    tabela). Inativas so com id_include_inactive.

  Input p_json:
    nr_version           integer  obrigatorio = 1
    nr_company, nr_branch  bigint  obrigatorios
    id_include_inactive  boolean  opcional (padrao false)

  Output jsonb: {"tables": [{"nr_price_table", "vc_name", "id_default", "vc_notes", "it_status",
                             "items": [{"nr_procedure", "vc_procedure", "vl_price", "vl_current_price"}]}]}

  Errors: VERSION_MISMATCH, PRICING_BRANCH_REQUIRED, PRICE_TABLE_FORBIDDEN
*/
create or replace function ad.price_table_list(p_json jsonb)
returns jsonb
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  _nr_company bigint;
  _nr_branch  bigint;
  _inactive   boolean := coalesce((p_json ->> 'id_include_inactive')::boolean, false);
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'price_table_list');
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('PRICING_BRANCH_REQUIRED');
  end if;
  if private.fn_current_user_nr() is null
     or not (coalesce((ad.fn_screen_permission(_nr_company, _nr_branch, 'PRICING') ->> 'id_read')::boolean, false)
             or coalesce((ad.fn_screen_permission(_nr_company, _nr_branch, 'BUDGETS') ->> 'id_read')::boolean, false)) then
    raise exception '%', ad.fn_message('PRICE_TABLE_FORBIDDEN');
  end if;

  return jsonb_build_object('tables', coalesce((
    select jsonb_agg(jsonb_build_object(
             'nr_price_table', t.nr_price_table, 'vc_name', t.vc_name, 'id_default', t.id_default,
             'vc_notes', t.vc_notes, 'it_status', t.it_status,
             'items', coalesce((
               select jsonb_agg(jsonb_build_object('nr_procedure', i.nr_procedure, 'vc_procedure', p.vc_name,
                        'vl_price', i.vl_price, 'vl_current_price', p.vl_current_price) order by p.vc_name)
                 from od.price_table_item i
                 join od.procedure p on p.nr_company = i.nr_company and p.nr_branch = i.nr_branch
                                    and p.nr_procedure = i.nr_procedure
                where i.nr_company = t.nr_company and i.nr_branch = t.nr_branch
                  and i.nr_price_table = t.nr_price_table), '[]'::jsonb))
           order by t.id_default desc, t.vc_name)
      from od.price_table t
     where t.nr_company = _nr_company and t.nr_branch = _nr_branch and (_inactive or t.it_status = 1)), '[]'::jsonb));
end;
$$;

revoke all on function ad.price_table_list(jsonb) from public, anon;
grant execute on function ad.price_table_list(jsonb) to authenticated;
