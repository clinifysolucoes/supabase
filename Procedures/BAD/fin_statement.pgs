/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.fin_statement(jsonb)                                       ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('fin_statement')         ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 04/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Extrato de uma conta (ou de todas as ativas, sem nr_account) num periodo:
    saldo no inicio, movimentos pagos (pela data do pagamento, entrada +,
    saida -) com o saldo apos cada um, e o saldo no fim. No maximo 2000
    movimentos. Exige permissao de LEITURA na tela FINANCE.

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company  bigint   obrigatorio
    nr_branch   bigint   obrigatorio
    nr_account  bigint   opcional
    dt_from     date     obrigatorio
    dt_to       date     obrigatorio (ate 400 dias)

  Output jsonb:
    {"vl_start", "vl_end", "vl_in", "vl_out",
     "movements": [{"nr_entry", "dt_paid", "it_kind", "vc_description", "vc_category",
                    "vc_account", "it_payment_method", "vl_value", "vl_balance"}]}

  Errors: VERSION_MISMATCH, FINANCE_BRANCH_REQUIRED, FINANCE_FORBIDDEN, FIN_LIST_FILTER_INVALID
*/
create or replace function ad.fin_statement(p_json jsonb)
returns jsonb
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  _nr_company bigint;
  _nr_branch  bigint;
  _account    bigint;
  _from       date;
  _to         date;
  _start      numeric;
  _result     jsonb;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'fin_statement');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('FINANCE_BRANCH_REQUIRED');
  end if;
  if not (ad.fn_screen_permission(_nr_company, _nr_branch, 'FINANCE') ->> 'id_read')::boolean then
    raise exception '%', ad.fn_message('FINANCE_FORBIDDEN');
  end if;
  begin
    _account := (p_json ->> 'nr_account')::bigint;
    _from    := (p_json ->> 'dt_from')::date;
    _to      := (p_json ->> 'dt_to')::date;
  exception when others then
    raise exception '%', ad.fn_message('FIN_LIST_FILTER_INVALID');
  end;
  if _from is null or _to is null or _to < _from or _to - _from > 400 then
    raise exception '%', ad.fn_message('FIN_LIST_FILTER_INVALID');
  end if;

  _start := od.fn_fin_balance(_nr_company, _nr_branch, _account, _from);

  with mv as (
    select e.nr_entry, e.dt_paid, e.it_kind, e.vc_description, c.vc_name as vc_category,
           a.vc_name as vc_account, e.it_payment_method,
           case when e.it_kind = 1 then e.vl_paid else -e.vl_paid end as vl_value
      from od.fin_entry e
      join od.fin_account a on a.nr_company = e.nr_company and a.nr_branch = e.nr_branch and a.nr_account = e.nr_account
      join od.fin_category c on c.nr_company = e.nr_company and c.nr_branch = e.nr_branch and c.nr_category = e.nr_category
     where e.nr_company = _nr_company and e.nr_branch = _nr_branch and e.it_status = 2
       and e.dt_paid between _from and _to
       and (_account is null and a.it_status = 1 or e.nr_account = _account)
     order by e.dt_paid, e.nr_entry
     limit 2000
  ), run as (
    select mv.*, _start + sum(mv.vl_value) over (order by mv.dt_paid, mv.nr_entry) as vl_balance from mv
  )
  select jsonb_build_object(
           'vl_start', _start,
           'vl_end', _start + coalesce(sum(run.vl_value), 0),
           'vl_in', coalesce(sum(run.vl_value) filter (where run.vl_value > 0), 0),
           'vl_out', coalesce(-sum(run.vl_value) filter (where run.vl_value < 0), 0),
           'movements', coalesce(jsonb_agg(jsonb_build_object(
                          'nr_entry', run.nr_entry, 'dt_paid', run.dt_paid, 'it_kind', run.it_kind,
                          'vc_description', run.vc_description, 'vc_category', run.vc_category,
                          'vc_account', run.vc_account, 'it_payment_method', run.it_payment_method,
                          'vl_value', run.vl_value, 'vl_balance', run.vl_balance)
                          order by run.dt_paid, run.nr_entry), '[]'::jsonb))
    into _result
    from run;

  return _result;
end;
$$;

revoke all on function ad.fin_statement(jsonb) from public, anon;
grant execute on function ad.fin_statement(jsonb) to authenticated;
