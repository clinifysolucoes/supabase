/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.radiology_save(jsonb)                                      ::
  ::  UsedBy      : Flutter -> rpc('radiology_save') (Exames de Imagem)           ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 23/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Cria (vc_action I, CRIAR na tela RADIOLOGY) ou altera (U, ALTERAR) um
    pedido de exame de imagem do paciente. Update parcial: chave presente
    altera, ausente mantem. Situacao:
      1 solicitado | 2 agendado | 3 realizado | 4 laudo recebido | 90 cancelado
    Passar para 3 preenche dt_done (hoje no fuso da filial, se nao vier);
    para 4 preenche dt_report e, se vazio, dt_done. Pedido cancelado nao muda.
    O centro e o profissional precisam estar ativos (ou ja serem os do pedido).

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company, nr_branch  bigint  obrigatorios
    vc_action   text     I | U
    nr_request  bigint   obrigatorio no U
    nr_patient  bigint   obrigatorio no I (paciente ativo; nao muda)
    nr_center, nr_professional  bigint  opcionais
    dt_request  date     padrao hoje
    ar_exams    text[]   obrigatorio no I (1 a 20 exames, cada um ate 80)
    vc_region (ate 120), vc_notes (ate 1000)  text
    it_status   integer  situacao
    dt_scheduled, dt_done, dt_report  date
    vc_report_url  text  link do laudo/imagens (https://, ate 500)

  Output jsonb: {"nr_request", "it_status"}

  Errors: VERSION_MISMATCH, RADIOLOGY_ACTION_INVALID, RADIOLOGY_BRANCH_REQUIRED, RADIOLOGY_FORBIDDEN,
    RADIOLOGY_NOT_FOUND, RADIOLOGY_CLOSED, RADIOLOGY_VALUE_INVALID, RADIOLOGY_PATIENT_INVALID,
    RADIOLOGY_CENTER_INVALID, RADIOLOGY_PROFESSIONAL_INVALID, RADIOLOGY_EXAMS_REQUIRED,
    RADIOLOGY_STATUS_INVALID, RADIOLOGY_URL_INVALID
*/
create or replace function ad.radiology_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _action     text := upper(coalesce(p_json ->> 'vc_action', ''));
  _perm       jsonb;
  _nr_request bigint;
  _old        od.radiology_request;
  _new        od.radiology_request;
  _today      date;
  _changed    text[];
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'radiology_save');
  if _action not in ('I', 'U') then
    raise exception '%', ad.fn_message('RADIOLOGY_ACTION_INVALID');
  end if;
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('RADIOLOGY_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'RADIOLOGY');
  if _nr_user is null
     or (_action = 'I' and not coalesce((_perm ->> 'id_create')::boolean, false))
     or (_action = 'U' and not coalesce((_perm ->> 'id_update')::boolean, false)) then
    raise exception '%', ad.fn_message('RADIOLOGY_FORBIDDEN');
  end if;
  _today := (now() at time zone coalesce((select b.vc_timezone from ad.branch b
                                          where b.nr_company = _nr_company and b.nr_branch = _nr_branch),
                                         'America/Sao_Paulo'))::date;

  if _action = 'U' then
    _nr_request := (p_json ->> 'nr_request')::bigint;
    select * into _old from od.radiology_request r
     where r.nr_company = _nr_company and r.nr_branch = _nr_branch and r.nr_request = _nr_request
     for update;
    if not found then
      raise exception '%', ad.fn_message('RADIOLOGY_NOT_FOUND');
    end if;
    if _old.it_status = 90 then
      raise exception '%', ad.fn_message('RADIOLOGY_CLOSED');
    end if;
    _new := _old;
  else
    begin
      _new.nr_patient := (p_json ->> 'nr_patient')::bigint;
    exception when others then
      raise exception '%', ad.fn_message('RADIOLOGY_VALUE_INVALID');
    end;
    if _new.nr_patient is null
       or not exists (select 1 from od.patient p
                       where p.nr_company = _nr_company and p.nr_branch = _nr_branch
                         and p.nr_patient = _new.nr_patient and p.it_status = 1) then
      raise exception '%', ad.fn_message('RADIOLOGY_PATIENT_INVALID');
    end if;
    _new.it_status  := 1;
    _new.dt_request := _today;
  end if;

  begin
    if p_json ? 'nr_center'       then _new.nr_center := (p_json ->> 'nr_center')::bigint; end if;
    if p_json ? 'nr_professional' then _new.nr_professional := (p_json ->> 'nr_professional')::bigint; end if;
    if p_json ? 'dt_request'      then _new.dt_request := coalesce((p_json ->> 'dt_request')::date, _today); end if;
    if p_json ? 'ar_exams' then
      _new.ar_exams := (select coalesce(array_agg(t order by o), '{}')
                          from (select nullif(trim(e), '') as t, o
                                  from jsonb_array_elements_text(p_json -> 'ar_exams') with ordinality x(e, o)) y
                         where t is not null);
    end if;
    if p_json ? 'vc_region'       then _new.vc_region := nullif(trim(p_json ->> 'vc_region'), ''); end if;
    if p_json ? 'vc_notes'        then _new.vc_notes := nullif(trim(p_json ->> 'vc_notes'), ''); end if;
    if p_json ? 'it_status'       then _new.it_status := (p_json ->> 'it_status')::smallint; end if;
    if p_json ? 'dt_scheduled'    then _new.dt_scheduled := (p_json ->> 'dt_scheduled')::date; end if;
    if p_json ? 'dt_done'         then _new.dt_done := (p_json ->> 'dt_done')::date; end if;
    if p_json ? 'dt_report'       then _new.dt_report := (p_json ->> 'dt_report')::date; end if;
    if p_json ? 'vc_report_url'   then _new.vc_report_url := nullif(trim(p_json ->> 'vc_report_url'), ''); end if;
  exception when others then
    raise exception '%', ad.fn_message('RADIOLOGY_VALUE_INVALID');
  end;

  if _new.ar_exams is null or cardinality(_new.ar_exams) = 0 then
    raise exception '%', ad.fn_message('RADIOLOGY_EXAMS_REQUIRED');
  end if;
  if cardinality(_new.ar_exams) > 20 or exists (select 1 from unnest(_new.ar_exams) e where length(e) > 80)
     or length(coalesce(_new.vc_region, '')) > 120 or length(coalesce(_new.vc_notes, '')) > 1000
     or _new.dt_done < _new.dt_request or _new.dt_report < coalesce(_new.dt_done, _new.dt_request) then
    raise exception '%', ad.fn_message('RADIOLOGY_VALUE_INVALID');
  end if;
  if _new.it_status is null or _new.it_status not in (1, 2, 3, 4, 90) then
    raise exception '%', ad.fn_message('RADIOLOGY_STATUS_INVALID');
  end if;
  if _new.vc_report_url is not null
     and (length(_new.vc_report_url) > 500 or _new.vc_report_url !~ '^https://\S+$') then
    raise exception '%', ad.fn_message('RADIOLOGY_URL_INVALID');
  end if;
  if _new.nr_center is not null
     and not exists (select 1 from od.radiology_center c
                      where c.nr_company = _nr_company and c.nr_branch = _nr_branch and c.nr_center = _new.nr_center
                        and (c.it_status = 1 or c.nr_center is not distinct from _old.nr_center)) then
    raise exception '%', ad.fn_message('RADIOLOGY_CENTER_INVALID');
  end if;
  if _new.nr_professional is not null
     and not exists (select 1 from od.professional p
                      where p.nr_company = _nr_company and p.nr_branch = _nr_branch
                        and p.nr_professional = _new.nr_professional
                        and (p.it_status = 1 or p.nr_professional is not distinct from _old.nr_professional)) then
    raise exception '%', ad.fn_message('RADIOLOGY_PROFESSIONAL_INVALID');
  end if;

  -- datas que a situacao implica
  if _new.it_status in (3, 4) and _new.dt_done is null then
    _new.dt_done := greatest(_today, _new.dt_request);
  end if;
  if _new.it_status = 4 and _new.dt_report is null then
    _new.dt_report := greatest(_today, _new.dt_done);
  end if;

  if _action = 'I' then
    perform 1 from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch for update;
    select coalesce(max(r.nr_request), 0) + 1 into _nr_request
      from od.radiology_request r where r.nr_company = _nr_company and r.nr_branch = _nr_branch;
    insert into od.radiology_request (
      nr_company, nr_branch, nr_request, nr_patient, nr_center, nr_professional, dt_request, ar_exams,
      vc_region, vc_notes, it_status, dt_scheduled, dt_done, dt_report, vc_report_url, nr_user_created)
    values (
      _nr_company, _nr_branch, _nr_request, _new.nr_patient, _new.nr_center, _new.nr_professional, _new.dt_request,
      _new.ar_exams, _new.vc_region, _new.vc_notes, _new.it_status, _new.dt_scheduled, _new.dt_done,
      _new.dt_report, _new.vc_report_url, _nr_user);
  else
    select array_agg(k) into _changed
      from jsonb_object_keys(p_json - 'nr_version' - 'nr_company' - 'nr_branch' - 'vc_action' - 'nr_request') k;
    update od.radiology_request r set
      nr_center = _new.nr_center, nr_professional = _new.nr_professional, dt_request = _new.dt_request,
      ar_exams = _new.ar_exams, vc_region = _new.vc_region, vc_notes = _new.vc_notes, it_status = _new.it_status,
      dt_scheduled = _new.dt_scheduled, dt_done = _new.dt_done, dt_report = _new.dt_report,
      vc_report_url = _new.vc_report_url
     where r.nr_company = _nr_company and r.nr_branch = _nr_branch and r.nr_request = _nr_request;
  end if;

  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'RADIOLOGY', case when _action = 'I' then 'CREATE' else 'UPDATE' end,
    'radiology_request', _nr_company::text || '/' || _nr_branch::text || '/' || _nr_request::text,
    format('Pedido de exame de imagem %s %s', _nr_request, case when _action = 'I' then 'criado' else 'alterado' end),
    jsonb_build_object('nr_patient', _new.nr_patient, 'it_status', _new.it_status, 'fields', to_jsonb(_changed)));

  return jsonb_build_object('nr_request', _nr_request, 'it_status', _new.it_status);
end;
$$;

revoke all on function ad.radiology_save(jsonb) from public, anon;
grant execute on function ad.radiology_save(jsonb) to authenticated;
