/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.fin_cash_close(jsonb)                                      ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('fin_cash_close')        ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 04/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Fecha uma sessao de caixa: guarda o valor contado e o esperado (saldo da
    conta no momento do fechamento); a diferenca e contado - esperado.
    O proprio usuario fecha o seu caixa com permissao CRIAR; fechar o caixa de
    outra pessoa exige ALTERAR na tela FINANCE. Grava ad.event_log.

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company  bigint   obrigatorio
    nr_branch   bigint   obrigatorio
    nr_session  bigint   opcional (padrao: o caixa aberto do usuario)
    vl_counted  numeric  obrigatorio (>= 0)
    vc_notes    text     opcional

  Output jsonb: {"nr_session", "vl_counted", "vl_expected", "vl_difference"}

  Errors: VERSION_MISMATCH, FINANCE_BRANCH_REQUIRED, FIN_CASH_FORBIDDEN, FIN_CASH_VALUE_INVALID,
    FIN_CASH_SESSION_NOT_FOUND, FIN_CASH_SESSION_CLOSED
*/
create or replace function ad.fin_cash_close(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _perm       jsonb;
  _nr         bigint;
  _counted    numeric;
  _notes      text;
  _cur        od.fin_cash_session%rowtype;
  _expected   numeric;
  _name       text;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'fin_cash_close');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('FINANCE_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'FINANCE');
  if _nr_user is null or not (_perm ->> 'id_create')::boolean then
    raise exception '%', ad.fn_message('FIN_CASH_FORBIDDEN');
  end if;
  begin
    _nr      := (p_json ->> 'nr_session')::bigint;
    _counted := round((p_json ->> 'vl_counted')::numeric, 2);
    _notes   := left(nullif(trim(p_json ->> 'vc_notes'), ''), 500);
  exception when others then
    raise exception '%', ad.fn_message('FIN_CASH_VALUE_INVALID');
  end;
  if _counted is null or _counted < 0 then
    raise exception '%', ad.fn_message('FIN_CASH_VALUE_INVALID');
  end if;

  select * into _cur from od.fin_cash_session s
   where s.nr_company = _nr_company and s.nr_branch = _nr_branch
     and (s.nr_session = _nr or (_nr is null and s.nr_user = _nr_user and s.it_status = 1))
     for update;
  if not found then
    raise exception '%', ad.fn_message('FIN_CASH_SESSION_NOT_FOUND');
  end if;
  if _cur.it_status <> 1 then
    raise exception '%', ad.fn_message('FIN_CASH_SESSION_CLOSED');
  end if;
  if _cur.nr_user <> _nr_user and not (_perm ->> 'id_update')::boolean then
    raise exception '%', ad.fn_message('FIN_CASH_FORBIDDEN');
  end if;

  _expected := od.fn_fin_balance(_nr_company, _nr_branch, _cur.nr_account, null);
  update od.fin_cash_session s set
    it_status = 2, dh_close = now(), vl_counted = _counted, vl_expected = _expected,
    nr_user_closed = _nr_user,
    vc_notes = coalesce(_notes, s.vc_notes)
  where s.nr_company = _nr_company and s.nr_branch = _nr_branch and s.nr_session = _cur.nr_session;

  select a.vc_name into _name from od.fin_account a
   where a.nr_company = _nr_company and a.nr_branch = _nr_branch and a.nr_account = _cur.nr_account;
  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'FINANCE', 'UPDATE',
    'fin_cash_session', _nr_company::text || '/' || _nr_branch::text || '/' || _cur.nr_session::text,
    format('Caixa fechado: %s', _name),
    jsonb_build_object('vl_counted', _counted, 'vl_expected', _expected, 'vl_difference', _counted - _expected));

  return jsonb_build_object('nr_session', _cur.nr_session, 'vl_counted', _counted,
                            'vl_expected', _expected, 'vl_difference', _counted - _expected);
end;
$$;

revoke all on function ad.fin_cash_close(jsonb) from public, anon;
grant execute on function ad.fin_cash_close(jsonb) to authenticated;
