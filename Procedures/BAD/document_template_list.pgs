/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.document_template_list(jsonb)                              ::
  ::  UsedBy      : Flutter -> rpc('document_template_list') (documentos)         ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 07/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Modelos de documento da filial. Na primeira chamada cria os modelos padrao
    (od.fn_document_default). Exige LER na tela PATIENTS ou SETTINGS; devolve
    os campos {{...}} disponiveis e se o usuario edita os modelos (alterar em
    SETTINGS).

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company, nr_branch  bigint  obrigatorios
    id_include_inactive    boolean opcional (padrao false)

  Output jsonb:
    {"templates": [{"nr_template", "it_kind", "vc_name", "vc_body", "it_status"}],
     "fields": ["paciente", ...], "permission": {"id_update"}}

  Errors: VERSION_MISMATCH, RECORD_BRANCH_REQUIRED, RECORD_FORBIDDEN
*/
create or replace function ad.document_template_list(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _inactive   boolean := coalesce((p_json ->> 'id_include_inactive')::boolean, false);
  _settings   jsonb;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'document_template_list');
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('RECORD_BRANCH_REQUIRED');
  end if;
  _nr_user  := private.fn_current_user_nr();
  _settings := ad.fn_screen_permission(_nr_company, _nr_branch, 'SETTINGS');
  if _nr_user is null
     or not (coalesce((ad.fn_screen_permission(_nr_company, _nr_branch, 'PATIENTS') ->> 'id_read')::boolean, false)
             or coalesce((_settings ->> 'id_read')::boolean, false)) then
    raise exception '%', ad.fn_message('RECORD_FORBIDDEN');
  end if;

  perform od.fn_document_default(_nr_company, _nr_branch, _nr_user);

  return jsonb_build_object(
    'templates', coalesce((
      select jsonb_agg(jsonb_build_object(
               'nr_template', t.nr_template, 'it_kind', t.it_kind, 'vc_name', t.vc_name,
               'vc_body', t.vc_body, 'it_status', t.it_status)
             order by t.it_kind, t.vc_name, t.nr_template)
        from od.document_template t
       where t.nr_company = _nr_company and t.nr_branch = _nr_branch
         and (_inactive or t.it_status = 1)), '[]'::jsonb),
    'fields', jsonb_build_array('paciente', 'cpf', 'rg', 'nascimento', 'idade', 'endereco', 'responsavel_paciente',
      'profissional', 'cro', 'clinica', 'cnpj', 'endereco_clinica', 'telefone_clinica', 'cidade',
      'responsavel_tecnico', 'cro_responsavel', 'foro', 'data', 'data_extenso', 'hora',
      'dias', 'cid', 'hora_inicio', 'hora_fim', 'valor', 'texto'),
    'permission', jsonb_build_object('id_update', coalesce((_settings ->> 'id_update')::boolean, false)));
end;
$$;

revoke all on function ad.document_template_list(jsonb) from public, anon;
grant execute on function ad.document_template_list(jsonb) to authenticated;
