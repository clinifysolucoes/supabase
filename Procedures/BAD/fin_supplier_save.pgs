/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.fin_supplier_save(jsonb)                                   ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('fin_supplier_save')     ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 04/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Cadastro de fornecedores do financeiro.
      vc_action = 'I'  cria (nr_supplier sequencial por filial) -> permissao CRIAR
      vc_action = 'U'  atualiza parcialmente (null limpa)       -> permissao ALTERAR
    CPF/CNPJ e telefone gravados so com digitos (CPF validado por
    ad.fn_cpf_is_valid); e-mail em minusculas. Grava ad.event_log sem
    documento e contato.

  Input p_json:
    nr_version   integer  obrigatorio = 1
    vc_action    text     obrigatorio 'I' | 'U'
    nr_company   bigint   obrigatorio
    nr_branch    bigint   obrigatorio
    nr_supplier  bigint   obrigatorio em 'U'
    vc_name      text     obrigatorio em 'I' (ate 120, unico na filial)
    vc_document  text     opcional (CPF 11 ou CNPJ 14, com ou sem mascara)
    vc_phone     text     opcional (10 ou 11 digitos)
    vc_email     text     opcional
    vc_notes     text     opcional (ate 500)
    it_status    integer  1 ativo | 90 inativo (so em 'U')

  Output jsonb: {"nr_company", "nr_branch", "nr_supplier"}

  Errors: VERSION_MISMATCH, FIN_SUPPLIER_ACTION_INVALID, FINANCE_BRANCH_REQUIRED, FIN_SUPPLIER_FORBIDDEN,
    FIN_SUPPLIER_NAME_REQUIRED, FIN_SUPPLIER_NAME_IN_USE {Name}, FIN_SUPPLIER_DOCUMENT_INVALID,
    FIN_SUPPLIER_PHONE_INVALID, FIN_SUPPLIER_EMAIL_INVALID, FIN_SUPPLIER_STATUS_INVALID,
    FIN_SUPPLIER_REQUIRED, FIN_SUPPLIER_NOT_FOUND
*/
create or replace function ad.fin_supplier_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user     bigint;
  _vc_action   text;
  _nr_company  bigint;
  _nr_branch   bigint;
  _nr_supplier bigint;
  _perm        jsonb;
  _vc_name     varchar(120);
  _doc         text;
  _phone       text;
  _email       text;
  _row         od.fin_supplier%rowtype;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'fin_supplier_save');

  _vc_action := upper(coalesce(p_json ->> 'vc_action', ''));
  if _vc_action not in ('I', 'U') then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_ACTION_INVALID');
  end if;
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('FINANCE_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'FINANCE');
  if _nr_user is null
     or (_vc_action = 'I' and not (_perm ->> 'id_create')::boolean)
     or (_vc_action = 'U' and not (_perm ->> 'id_update')::boolean) then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_FORBIDDEN');
  end if;

  if p_json ? 'vc_name' or _vc_action = 'I' then
    _vc_name := left(nullif(trim(p_json ->> 'vc_name'), ''), 120);
    if _vc_name is null then
      raise exception '%', ad.fn_message('FIN_SUPPLIER_NAME_REQUIRED');
    end if;
  end if;

  _doc := nullif(upper(regexp_replace(coalesce(p_json ->> 'vc_document', ''), '[^0-9A-Za-z]', '', 'g')), '');
  if _doc is not null and not (
       (length(_doc) = 11 and _doc ~ '^[0-9]+$' and ad.fn_cpf_is_valid(_doc))
       or (length(_doc) = 14 and _doc ~ '^[0-9A-Z]+$')) then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_DOCUMENT_INVALID');
  end if;
  _phone := nullif(regexp_replace(coalesce(p_json ->> 'vc_phone', ''), '[^0-9]', '', 'g'), '');
  if _phone is not null and _phone !~ '^[0-9]{10,11}$' then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_PHONE_INVALID');
  end if;
  _email := nullif(lower(trim(coalesce(p_json ->> 'vc_email', ''))), '');
  if _email is not null and _email !~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_EMAIL_INVALID');
  end if;
  if p_json ? 'it_status' and coalesce((p_json ->> 'it_status')::smallint, 0) not in (1, 90) then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_STATUS_INVALID');
  end if;

  if _vc_action = 'U' then
    _nr_supplier := (p_json ->> 'nr_supplier')::bigint;
    if _nr_supplier is null then
      raise exception '%', ad.fn_message('FIN_SUPPLIER_REQUIRED');
    end if;
    if not exists (select 1 from od.fin_supplier s
                    where s.nr_company = _nr_company and s.nr_branch = _nr_branch and s.nr_supplier = _nr_supplier) then
      raise exception '%', ad.fn_message('FIN_SUPPLIER_NOT_FOUND');
    end if;
  end if;
  if _vc_name is not null and exists (
       select 1 from od.fin_supplier s
        where s.nr_company = _nr_company and s.nr_branch = _nr_branch
          and lower(s.vc_name) = lower(_vc_name) and s.nr_supplier is distinct from _nr_supplier) then
    raise exception '%', ad.fn_message('FIN_SUPPLIER_NAME_IN_USE', jsonb_build_object('Name', _vc_name));
  end if;

  if _vc_action = 'I' then
    perform 1 from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch for update;
    select coalesce(max(s.nr_supplier), 0) + 1 into _nr_supplier
      from od.fin_supplier s where s.nr_company = _nr_company and s.nr_branch = _nr_branch;
    insert into od.fin_supplier (nr_company, nr_branch, nr_supplier, vc_name, vc_document, vc_phone,
                                 vc_email, vc_notes, nr_operator)
    values (_nr_company, _nr_branch, _nr_supplier, _vc_name, _doc, _phone, _email,
            left(nullif(trim(p_json ->> 'vc_notes'), ''), 500), _nr_user)
    returning * into _row;
  else
    update od.fin_supplier s set
      vc_name     = case when p_json ? 'vc_name'     then _vc_name                                           else s.vc_name end,
      vc_document = case when p_json ? 'vc_document' then _doc                                               else s.vc_document end,
      vc_phone    = case when p_json ? 'vc_phone'    then _phone                                             else s.vc_phone end,
      vc_email    = case when p_json ? 'vc_email'    then _email                                             else s.vc_email end,
      vc_notes    = case when p_json ? 'vc_notes'    then left(nullif(trim(p_json ->> 'vc_notes'), ''), 500) else s.vc_notes end,
      it_status   = case when p_json ? 'it_status'   then (p_json ->> 'it_status')::smallint                 else s.it_status end
    where s.nr_company = _nr_company and s.nr_branch = _nr_branch and s.nr_supplier = _nr_supplier
    returning s.* into _row;
  end if;

  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'FINANCE',
    case when _vc_action = 'I' then 'CREATE' else 'UPDATE' end,
    'fin_supplier', _nr_company::text || '/' || _nr_branch::text || '/' || _nr_supplier::text,
    format('Fornecedor %s %s', _row.vc_name, case when _vc_action = 'I' then 'cadastrado' else 'alterado' end),
    jsonb_build_object('vc_name', _row.vc_name, 'it_status', _row.it_status));

  return jsonb_build_object('nr_company', _nr_company, 'nr_branch', _nr_branch, 'nr_supplier', _nr_supplier);
end;
$$;

revoke all on function ad.fin_supplier_save(jsonb) from public, anon;
grant execute on function ad.fin_supplier_save(jsonb) to authenticated;
