/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.branch_create(jsonb)                                       ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('branch_create')         ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 13/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Cria uma nova filial na empresa (somente administrador). nr_branch e
    sequencial por empresa (como AD002_NR_FILIAL): a linha da empresa e
    travada (FOR UPDATE) para serializar a numeracao. O criador e vinculado
    a nova filial com o perfil de maior nivel que ja possui na empresa, para
    nao criar uma filial em que ninguem entra.

  Input p_json:
    nr_version     integer  obrigatorio = 1
    nr_company     bigint   obrigatorio
    vc_name        text     obrigatorio (nome fantasia)
    vc_legal_name, vc_cnpj, vc_email, vc_phone, it_size, it_tax_regime,
    vc_state_registration, vc_city_registration,
    vc_address, vc_address_number, vc_address_extra, vc_district, vc_city,
    vc_state, vc_zip_code, vc_timezone                 opcionais

  Output jsonb: {"nr_company": 1, "nr_branch": 2}

  Errors: VERSION_MISMATCH, BRANCH_CREATE_COMPANY_REQUIRED, BRANCH_CREATE_FORBIDDEN,
    BRANCH_CREATE_NAME_REQUIRED, BRANCH_CREATE_CNPJ_INVALID {Cnpj},
    BRANCH_CREATE_CNPJ_IN_USE {Cnpj}, BRANCH_CREATE_EMAIL_INVALID {Email},
    BRANCH_CREATE_TIMEZONE_INVALID {Timezone}
*/

create or replace function ad.branch_create(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user     bigint;
  _nr_company  bigint;
  _nr_branch   bigint;
  _nr_profile  bigint;
  _vc_name     varchar(60);
  _vc_cnpj     varchar(14);
  _vc_email    varchar(200);
  _vc_timezone varchar(60);
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'branch_create');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  if _nr_company is null then
    raise exception '%', ad.fn_message('BRANCH_CREATE_COMPANY_REQUIRED');
  end if;

  _nr_user := private.fn_current_user_nr();
  if _nr_user is null or not private.fn_is_company_admin(_nr_company) then
    raise exception '%', ad.fn_message('BRANCH_CREATE_FORBIDDEN');
  end if;

  _vc_name := left(nullif(trim(p_json ->> 'vc_name'), ''), 60);
  if _vc_name is null then
    raise exception '%', ad.fn_message('BRANCH_CREATE_NAME_REQUIRED');
  end if;

  _vc_cnpj := ad.fn_cnpj_normalize(p_json ->> 'vc_cnpj');
  if _vc_cnpj is not null and not ad.fn_cnpj_is_valid(_vc_cnpj) then
    raise exception '%', ad.fn_message('BRANCH_CREATE_CNPJ_INVALID', jsonb_build_object('Cnpj', _vc_cnpj));
  end if;
  if _vc_cnpj is not null and exists (select 1 from ad.branch b where b.vc_cnpj = _vc_cnpj) then
    raise exception '%', ad.fn_message('BRANCH_CREATE_CNPJ_IN_USE', jsonb_build_object('Cnpj', _vc_cnpj));
  end if;

  _vc_email := left(nullif(lower(trim(p_json ->> 'vc_email')), ''), 200);
  if _vc_email is not null and not ad.fn_email_is_valid(_vc_email) then
    raise exception '%', ad.fn_message('BRANCH_CREATE_EMAIL_INVALID', jsonb_build_object('Email', _vc_email));
  end if;

  _vc_timezone := coalesce(left(nullif(trim(p_json ->> 'vc_timezone'), ''), 60), 'America/Sao_Paulo');
  if not exists (select 1 from pg_catalog.pg_timezone_names tz where tz.name = _vc_timezone) then
    raise exception '%', ad.fn_message('BRANCH_CREATE_TIMEZONE_INVALID', jsonb_build_object('Timezone', _vc_timezone));
  end if;

  /* Serializa a numeracao por empresa */
  perform 1 from ad.company c where c.nr_company = _nr_company for update;

  select coalesce(max(b.nr_branch), 0) + 1
    into _nr_branch
    from ad.branch b
   where b.nr_company = _nr_company;

  insert into ad.branch (
    nr_company, nr_branch, vc_name, vc_legal_name, vc_cnpj, vc_email, vc_phone,
    it_size, it_tax_regime, vc_state_registration, vc_city_registration,
    vc_address, vc_address_number, vc_address_extra, vc_district, vc_city, vc_state, vc_zip_code,
    vc_timezone, id_main, nr_operator
  ) values (
    _nr_company, _nr_branch, _vc_name,
    left(nullif(trim(p_json ->> 'vc_legal_name'), ''), 80),
    _vc_cnpj, _vc_email,
    left(nullif(trim(p_json ->> 'vc_phone'), ''), 20),
    (p_json ->> 'it_size')::smallint,
    (p_json ->> 'it_tax_regime')::smallint,
    left(nullif(trim(p_json ->> 'vc_state_registration'), ''), 20),
    left(nullif(trim(p_json ->> 'vc_city_registration'), ''), 20),
    left(nullif(trim(p_json ->> 'vc_address'), ''), 60),
    left(nullif(trim(p_json ->> 'vc_address_number'), ''), 10),
    left(nullif(trim(p_json ->> 'vc_address_extra'), ''), 60),
    left(nullif(trim(p_json ->> 'vc_district'), ''), 30),
    left(nullif(trim(p_json ->> 'vc_city'), ''), 30),
    upper(left(nullif(trim(p_json ->> 'vc_state'), ''), 2)),
    nullif(regexp_replace(coalesce(p_json ->> 'vc_zip_code', ''), '[^0-9]', '', 'g'), ''),
    _vc_timezone, false, _nr_user
  );

  /* Vincula o criador com o perfil de maior nivel que ele ja tem na empresa */
  select bup.nr_profile
    into _nr_profile
    from ad.branch_user_profile bup
    join ad.access_profile p on p.nr_company = bup.nr_company and p.nr_profile = bup.nr_profile
   where bup.nr_company = _nr_company
     and bup.nr_user    = _nr_user
     and p.it_status    = 1
   order by p.it_level desc, p.nr_profile
   limit 1;

  if _nr_profile is not null then
    insert into ad.branch_user_profile (nr_company, nr_branch, nr_user, nr_profile, nr_operator)
    values (_nr_company, _nr_branch, _nr_user, _nr_profile, _nr_user);
  end if;

  perform ad.fn_event_log(_nr_user, _nr_company, _nr_branch, null, 'CREATE', 'branch',
    _nr_company::text || '/' || _nr_branch::text, format('Filial %s criada', _vc_name),
    jsonb_build_object('vc_name', _vc_name, 'vc_cnpj', _vc_cnpj));

  return jsonb_build_object('nr_company', _nr_company, 'nr_branch', _nr_branch);
end;
$$;

revoke all on function ad.branch_create(jsonb) from public, anon;
grant execute on function ad.branch_create(jsonb) to authenticated;
