/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.user_password_reset_check(jsonb)                           ::
  ::  UsedBy      : Edge Function user-password-reset (antes de trocar a senha)   ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 05/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Checagem antes de o administrador da empresa definir uma senha nova para
    um usuario dela (a troca no Supabase Auth e da Edge Function, com
    service_role). Garante que quem chama e administrador da empresa, que o
    usuario esta vinculado a ela e que a conta nao e compartilhada: usuario
    de outra empresa ou administrador da plataforma so troca a propria senha
    (senao o admin de uma empresa tomaria a conta usada em outra). Devolve o
    id da conta no Auth e grava ad.event_log (sem a senha).

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company  bigint   obrigatorio
    nr_branch   bigint   opcional (filial aberta no app, so para o log)
    nr_user     bigint   obrigatorio

  Output jsonb: {"uu_auth": uuid, "nr_user": bigint, "vc_name": "..."}

  Errors (ad.fn_message): VERSION_MISMATCH, USER_PASSWORD_COMPANY_REQUIRED,
    USER_PASSWORD_FORBIDDEN, COMPANY_USER_USER_REQUIRED, COMPANY_USER_NOT_FOUND,
    USER_PASSWORD_SHARED
*/
create or replace function ad.user_password_reset_check(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_admin   bigint;
  _nr_company bigint;
  _nr_user    bigint;
  _user       ad.app_user%rowtype;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'user_password_reset_check');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  if _nr_company is null then
    raise exception '%', ad.fn_message('USER_PASSWORD_COMPANY_REQUIRED');
  end if;
  _nr_admin := private.fn_current_user_nr();
  if _nr_admin is null or not private.fn_is_company_admin(_nr_company) then
    raise exception '%', ad.fn_message('USER_PASSWORD_FORBIDDEN');
  end if;

  _nr_user := (p_json ->> 'nr_user')::bigint;
  if _nr_user is null then
    raise exception '%', ad.fn_message('COMPANY_USER_USER_REQUIRED');
  end if;
  select u.* into _user
    from ad.app_user u
    join ad.company_user cu on cu.nr_user = u.nr_user and cu.nr_company = _nr_company
   where u.nr_user = _nr_user;
  if not found then
    raise exception '%', ad.fn_message('COMPANY_USER_NOT_FOUND');
  end if;
  if _nr_user <> _nr_admin and (
       _user.it_level >= 100
       or exists (select 1 from ad.company_user cu
                   where cu.nr_user = _nr_user and cu.nr_company <> _nr_company)) then
    raise exception '%', ad.fn_message('USER_PASSWORD_SHARED');
  end if;

  perform ad.fn_event_log(
    _nr_admin, _nr_company, (p_json ->> 'nr_branch')::bigint, 'USERS', 'UPDATE',
    'app_user', _nr_user::text,
    format('Senha de %s redefinida pelo administrador', _user.vc_name),
    jsonb_build_object('nr_user', _nr_user));

  return jsonb_build_object('uu_auth', _user.uu_auth, 'nr_user', _nr_user, 'vc_name', _user.vc_name);
end;
$$;

revoke all on function ad.user_password_reset_check(jsonb) from public, anon;
grant execute on function ad.user_password_reset_check(jsonb) to authenticated;
