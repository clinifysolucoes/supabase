/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.settings_save(jsonb)                                       ::
  ::  UsedBy      : Flutter -> rpc('settings_save') (tela Configuracoes)          ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 05/11/2026                                                    ::
  ::  Change      : 06/11/2026 - aliquotas do DRE e numeracao dos recibos         ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Grava as preferencias da filial (od.branch_setting, criada na primeira
    vez) com update parcial: chave presente altera, ausente mantem. Com
    "hours" (lista, pode ser vazia) substitui o horario de funcionamento.
    Permissao ALTERAR da tela SETTINGS. Dados da clinica ficam em
    ad.branch_update (administrador). Grava ad.event_log.

  Input p_json:
    nr_version              integer  obrigatorio = 1
    nr_company, nr_branch   bigint   obrigatorios
    qt_slot_minutes         integer  opcional 5 | 15 | 20 | 30
    qt_max_parallel         integer  opcional 1..20 (consultas do mesmo profissional no mesmo horario)
    id_allow_outside_hours  boolean  opcional (agendar fora do horario de atendimento)
    id_auto_record_number   boolean  opcional (numero de prontuario automatico)
    nr_next_record          bigint   opcional >= 1 (proximo numero)
    vc_patient_required     array    opcional campos obrigatorios no cadastro do paciente (alem de
                                     nome, nascimento e CPF, que sempre sao): rg, gender,
                                     marital_status, education, source, referral, mobile, phone,
                                     email, address, profession, plan
    hours                   array    opcional [{"it_weekday": 0..6, "qt_minute_start", "qt_minute_end"}]
    it_debt_rule            integer  opcional 1 nao bloquear | 2 avisar | 3 administrador libera | 4 bloquear
                                     (paciente com conta a receber vencida ao agendar)
    qt_debt_days            integer  opcional 0..365 (tolerancia depois do vencimento)
    id_cash_enabled         boolean  opcional (usa o caixa do dia)
    it_payment_methods      array    opcional formas aceitas ao receber (1..7, 9; ao menos uma)
    pc_late_fee             numeric  opcional 0..10 (multa por atraso, % do valor)
    pc_late_interest        numeric  opcional 0..10 (juros de mora ao mes, pro rata dia)
    pc_dre_revenue_tax, pc_dre_income_tax, pc_dre_csll  numeric  opcionais 0..50 (aliquotas do DRE)
    vc_receipt_prefix       text     opcional ate 10 (prefixo do numero do recibo: letras, numeros, - / .)
    nr_next_receipt         bigint   opcional >= 1 (proximo numero de recibo)

  Output jsonb: o mesmo de ad.settings_get

  Errors: VERSION_MISMATCH, SETTINGS_BRANCH_REQUIRED, SETTINGS_FORBIDDEN, SETTINGS_VALUE_INVALID,
    SETTINGS_SLOT_INVALID, SETTINGS_PARALLEL_INVALID, SETTINGS_RECORD_INVALID, SETTINGS_HOURS_INVALID,
    SETTINGS_DEBT_INVALID, SETTINGS_METHODS_INVALID, SETTINGS_LATE_INVALID, SETTINGS_DRE_INVALID,
    SETTINGS_RECEIPT_INVALID
*/
create or replace function ad.settings_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _cur        od.branch_setting%rowtype;
  _new        od.branch_setting%rowtype;
  _h          jsonb;
  _i          integer := 0;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'settings_save');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('SETTINGS_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  if _nr_user is null
     or not (ad.fn_screen_permission(_nr_company, _nr_branch, 'SETTINGS') ->> 'id_update')::boolean then
    raise exception '%', ad.fn_message('SETTINGS_FORBIDDEN');
  end if;

  perform 1 from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch for update;
  select * into _cur from od.branch_setting s where s.nr_company = _nr_company and s.nr_branch = _nr_branch;
  if not found then
    _cur.qt_slot_minutes := 15;
    _cur.qt_max_parallel := 1;
    _cur.id_allow_outside_hours := true;
    _cur.id_auto_record_number := false;
    _cur.nr_next_record := 1;
    _cur.vc_patient_required := '{}';
    _cur.it_debt_rule := 1;
    _cur.qt_debt_days := 0;
    _cur.id_cash_enabled := true;
    _cur.it_payment_methods := '{1,2,3,4,5,6,7,9}';
    _cur.pc_late_fee := 0;
    _cur.pc_late_interest := 0;
    _cur.pc_dre_revenue_tax := 0;
    _cur.pc_dre_income_tax := 0;
    _cur.pc_dre_csll := 0;
    _cur.vc_receipt_prefix := '';
    _cur.nr_next_receipt := 1;
  end if;

  begin
    _new.qt_slot_minutes        := case when p_json ? 'qt_slot_minutes'        then (p_json ->> 'qt_slot_minutes')::smallint       else _cur.qt_slot_minutes end;
    _new.qt_max_parallel        := case when p_json ? 'qt_max_parallel'        then (p_json ->> 'qt_max_parallel')::smallint       else _cur.qt_max_parallel end;
    _new.id_allow_outside_hours := case when p_json ? 'id_allow_outside_hours' then (p_json ->> 'id_allow_outside_hours')::boolean else _cur.id_allow_outside_hours end;
    _new.id_auto_record_number  := case when p_json ? 'id_auto_record_number'  then (p_json ->> 'id_auto_record_number')::boolean  else _cur.id_auto_record_number end;
    _new.nr_next_record         := case when p_json ? 'nr_next_record'         then (p_json ->> 'nr_next_record')::bigint          else _cur.nr_next_record end;
    if p_json ? 'vc_patient_required' then
      if jsonb_typeof(p_json -> 'vc_patient_required') <> 'array' then
        raise exception '%', ad.fn_message('SETTINGS_VALUE_INVALID');
      end if;
      select coalesce(array_agg(distinct f.value order by f.value), '{}')
        into _new.vc_patient_required
        from jsonb_array_elements_text(p_json -> 'vc_patient_required') f;
    else
      _new.vc_patient_required := _cur.vc_patient_required;
    end if;
    _new.it_debt_rule           := case when p_json ? 'it_debt_rule'           then (p_json ->> 'it_debt_rule')::smallint          else _cur.it_debt_rule end;
    _new.qt_debt_days           := case when p_json ? 'qt_debt_days'           then (p_json ->> 'qt_debt_days')::smallint          else _cur.qt_debt_days end;
    _new.id_cash_enabled        := case when p_json ? 'id_cash_enabled'        then (p_json ->> 'id_cash_enabled')::boolean        else _cur.id_cash_enabled end;
    _new.pc_late_fee            := case when p_json ? 'pc_late_fee'            then round((p_json ->> 'pc_late_fee')::numeric, 2)  else _cur.pc_late_fee end;
    _new.pc_late_interest       := case when p_json ? 'pc_late_interest'       then round((p_json ->> 'pc_late_interest')::numeric, 2) else _cur.pc_late_interest end;
    _new.pc_dre_revenue_tax := case when p_json ? 'pc_dre_revenue_tax' then round((p_json ->> 'pc_dre_revenue_tax')::numeric, 2) else _cur.pc_dre_revenue_tax end;
    _new.pc_dre_income_tax  := case when p_json ? 'pc_dre_income_tax'  then round((p_json ->> 'pc_dre_income_tax')::numeric, 2)  else _cur.pc_dre_income_tax end;
    _new.pc_dre_csll        := case when p_json ? 'pc_dre_csll'        then round((p_json ->> 'pc_dre_csll')::numeric, 2)        else _cur.pc_dre_csll end;
    _new.vc_receipt_prefix      := case when p_json ? 'vc_receipt_prefix'      then upper(coalesce(trim(p_json ->> 'vc_receipt_prefix'), '')) else _cur.vc_receipt_prefix end;
    _new.nr_next_receipt        := case when p_json ? 'nr_next_receipt'        then (p_json ->> 'nr_next_receipt')::bigint         else _cur.nr_next_receipt end;
    if p_json ? 'it_payment_methods' then
      if jsonb_typeof(p_json -> 'it_payment_methods') <> 'array' then
        raise exception '%', ad.fn_message('SETTINGS_METHODS_INVALID');
      end if;
      select coalesce(array_agg(distinct m.value::smallint order by m.value::smallint), '{}')
        into _new.it_payment_methods
        from jsonb_array_elements_text(p_json -> 'it_payment_methods') m;
    else
      _new.it_payment_methods := _cur.it_payment_methods;
    end if;
  exception
    when raise_exception then raise;
    when others then
    raise exception '%', ad.fn_message('SETTINGS_VALUE_INVALID');
  end;
  if _new.qt_slot_minutes is null or _new.qt_slot_minutes not in (5, 15, 20, 30) then
    raise exception '%', ad.fn_message('SETTINGS_SLOT_INVALID');
  end if;
  if _new.qt_max_parallel is null or _new.qt_max_parallel not between 1 and 20 then
    raise exception '%', ad.fn_message('SETTINGS_PARALLEL_INVALID');
  end if;
  if _new.nr_next_record is null or _new.nr_next_record < 1 then
    raise exception '%', ad.fn_message('SETTINGS_RECORD_INVALID');
  end if;
  if _new.it_debt_rule is null or _new.it_debt_rule not in (1, 2, 3, 4)
     or _new.qt_debt_days is null or _new.qt_debt_days not between 0 and 365 then
    raise exception '%', ad.fn_message('SETTINGS_DEBT_INVALID');
  end if;
  if cardinality(_new.it_payment_methods) = 0
     or not _new.it_payment_methods <@ '{1,2,3,4,5,6,7,9}'::smallint[] then
    raise exception '%', ad.fn_message('SETTINGS_METHODS_INVALID');
  end if;
  if _new.pc_late_fee is null or _new.pc_late_fee not between 0 and 10
     or _new.pc_late_interest is null or _new.pc_late_interest not between 0 and 10 then
    raise exception '%', ad.fn_message('SETTINGS_LATE_INVALID');
  end if;
  if _new.nr_next_receipt is null or _new.nr_next_receipt < 1
     or length(_new.vc_receipt_prefix) > 10 or _new.vc_receipt_prefix !~ '^[A-Z0-9./-]*$' then
    raise exception '%', ad.fn_message('SETTINGS_RECEIPT_INVALID');
  end if;
  if coalesce(_new.pc_dre_revenue_tax, -1) not between 0 and 50 or coalesce(_new.pc_dre_income_tax, -1) not between 0 and 50
     or coalesce(_new.pc_dre_csll, -1) not between 0 and 50 then
    raise exception '%', ad.fn_message('SETTINGS_DRE_INVALID');
  end if;
  if _new.id_allow_outside_hours is null or _new.id_auto_record_number is null
     or _new.id_cash_enabled is null
     or not _new.vc_patient_required <@ '{rg,gender,marital_status,education,source,referral,mobile,phone,email,address,profession,plan}'::text[] then
    raise exception '%', ad.fn_message('SETTINGS_VALUE_INVALID');
  end if;

  insert into od.branch_setting (nr_company, nr_branch, qt_slot_minutes, qt_max_parallel, id_allow_outside_hours,
                                 id_auto_record_number, nr_next_record, vc_patient_required,
                                 it_debt_rule, qt_debt_days, id_cash_enabled, it_payment_methods, pc_late_fee,
                                 pc_late_interest, pc_dre_revenue_tax, pc_dre_income_tax, pc_dre_csll,
                                 vc_receipt_prefix, nr_next_receipt, nr_operator)
  values (_nr_company, _nr_branch, _new.qt_slot_minutes, _new.qt_max_parallel, _new.id_allow_outside_hours,
          _new.id_auto_record_number, _new.nr_next_record, _new.vc_patient_required,
          _new.it_debt_rule, _new.qt_debt_days, _new.id_cash_enabled, _new.it_payment_methods, _new.pc_late_fee,
          _new.pc_late_interest, _new.pc_dre_revenue_tax, _new.pc_dre_income_tax, _new.pc_dre_csll,
          _new.vc_receipt_prefix, _new.nr_next_receipt, _nr_user)
  on conflict (nr_company, nr_branch) do update set
    qt_slot_minutes        = excluded.qt_slot_minutes,
    qt_max_parallel        = excluded.qt_max_parallel,
    id_allow_outside_hours = excluded.id_allow_outside_hours,
    id_auto_record_number  = excluded.id_auto_record_number,
    nr_next_record         = excluded.nr_next_record,
    vc_patient_required    = excluded.vc_patient_required,
    it_debt_rule           = excluded.it_debt_rule,
    qt_debt_days           = excluded.qt_debt_days,
    id_cash_enabled        = excluded.id_cash_enabled,
    it_payment_methods     = excluded.it_payment_methods,
    pc_late_fee            = excluded.pc_late_fee,
    pc_late_interest       = excluded.pc_late_interest,
    pc_dre_revenue_tax     = excluded.pc_dre_revenue_tax,
    pc_dre_income_tax      = excluded.pc_dre_income_tax,
    pc_dre_csll            = excluded.pc_dre_csll,
    vc_receipt_prefix      = excluded.vc_receipt_prefix,
    nr_next_receipt        = excluded.nr_next_receipt;

  if p_json ? 'hours' then
    if jsonb_typeof(p_json -> 'hours') <> 'array' then
      raise exception '%', ad.fn_message('SETTINGS_HOURS_INVALID');
    end if;
    delete from od.branch_hour h where h.nr_company = _nr_company and h.nr_branch = _nr_branch;
    for _h in select * from jsonb_array_elements(p_json -> 'hours') loop
      _i := _i + 1;
      begin
        insert into od.branch_hour (nr_company, nr_branch, nr_hour, it_weekday, qt_minute_start, qt_minute_end, nr_operator)
        values (_nr_company, _nr_branch, _i, (_h ->> 'it_weekday')::smallint,
                (_h ->> 'qt_minute_start')::smallint, (_h ->> 'qt_minute_end')::smallint, _nr_user);
      exception when others then
        raise exception '%', ad.fn_message('SETTINGS_HOURS_INVALID');
      end;
    end loop;
    if exists (select 1 from od.branch_hour a join od.branch_hour b
                 on b.nr_company = a.nr_company and b.nr_branch = a.nr_branch and b.it_weekday = a.it_weekday
                and b.nr_hour > a.nr_hour and b.qt_minute_start < a.qt_minute_end and a.qt_minute_start < b.qt_minute_end
                where a.nr_company = _nr_company and a.nr_branch = _nr_branch) then
      raise exception '%', ad.fn_message('SETTINGS_HOURS_INVALID');
    end if;
  end if;

  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'SETTINGS', 'UPDATE',
    'branch_setting', _nr_company::text || '/' || _nr_branch::text,
    'Configurações da filial alteradas',
    (p_json - 'nr_version' - 'nr_company' - 'nr_branch'));

  return ad.settings_get(jsonb_build_object('nr_version', 1, 'nr_company', _nr_company, 'nr_branch', _nr_branch));
end;
$$;

revoke all on function ad.settings_save(jsonb) from public, anon;
grant execute on function ad.settings_save(jsonb) to authenticated;
