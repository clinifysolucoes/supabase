/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.clinical_evolution_save(jsonb)                             ::
  ::  UsedBy      : Flutter -> rpc('clinical_evolution_save') (prontuario)        ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 07/11/2026                                                    ::
  ::  Change      : 18/11/2026 - sessoes, retorno e tempo de execucao             ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Evolucao clinica do paciente (tela PATIENTS).
      vc_action = 'I'  registra o atendimento (texto, profissional, dente) e, com
                       nr_budget + nr_item, marca o item do orcamento aprovado como
                       realizado                                -> CRIAR ou ALTERAR
      vc_action = 'D'  exclui (it_status 90) e desmarca o item realizado -> ALTERAR
    A evolucao nao e alterada depois de gravada (registro clinico): para corrigir,
    exclui e registra de novo. Grava ad.event_log sem o texto.
    Estoque: o procedimento registrado baixa os materiais da ficha tecnica com
    controle de estoque (od.fn_stock_evolution); a exclusao estorna a baixa.

  Input p_json:
    nr_version       integer  obrigatorio = 1
    vc_action        text     obrigatorio 'I' | 'D'
    nr_company, nr_branch, nr_patient  bigint  obrigatorios
    vc_text          text     obrigatorio em 'I' (ate 4000)
    dh_evolution     timestamptz opcional (padrao agora; nao pode ser futura)
    nr_professional  bigint   opcional
    vc_tooth         text     opcional (ate 40)
    nr_procedure     bigint   opcional
    nr_budget, nr_item        opcionais (item de orcamento aprovado do paciente, ainda nao realizado)
    nr_evolution     bigint   obrigatorio em 'D'
    id_block_override boolean opcional (administrador confirma registrar com pendencia)
    qt_minutes       integer  opcional 1..600 (tempo de execucao; so com id_record_time)
    Sessoes (od.branch_setting.id_record_sessions): o item do orcamento fica
    realizado (dt_done) so quando qt_sessions_done chega a qt_sessions; cada
    evolucao do item e uma sessao (nr_session). Sem sessoes, uma evolucao
    conclui o item. A exclusao desfaz a sessao.
    Retorno (id_record_return): ao concluir um procedimento com qt_return_days,
    o alerta de retorno do paciente passa para a data da evolucao + N dias (se
    ele nao tiver alerta futuro mais proximo).

  Output jsonb: {"nr_evolution", "nr_session" (null sem sessoes), "id_item_done", "dt_return_alert" (novo
                 alerta, se houver), "block": {"vc_kind", "qt_entries", "vl_total"} | null}
    Bloqueios do tratamento (od.fn_patient_block 'TREAT'): na inclusao, conta
    vencida, conta em aberto ou contrato sem assinatura conforme as regras
    it_treat_* da filial: 2 registra e devolve "block", 3 so o administrador
    registra confirmando com id_block_override, 4 bloqueia.

  Errors: VERSION_MISMATCH, CLINICAL_EVOLUTION_ACTION_INVALID, RECORD_BRANCH_REQUIRED,
    CLINICAL_EVOLUTION_FORBIDDEN, PATIENT_REQUIRED, PATIENT_NOT_FOUND, CLINICAL_EVOLUTION_TEXT_REQUIRED,
    CLINICAL_EVOLUTION_VALUE_INVALID, CLINICAL_EVOLUTION_PROFESSIONAL_INVALID,
    CLINICAL_EVOLUTION_PROCEDURE_INVALID, CLINICAL_EVOLUTION_ITEM_INVALID, CLINICAL_EVOLUTION_NOT_FOUND,
    CLINICAL_EVOLUTION_BLOCKED {Kind, Amount}, CLINICAL_EVOLUTION_APPROVAL {Kind, Amount},
    CLINICAL_EVOLUTION_CONFIRM {Kind, Amount}, CLINICAL_EVOLUTION_MINUTES_INVALID
*/
create or replace function ad.clinical_evolution_save(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _action     text := upper(coalesce(p_json ->> 'vc_action', ''));
  _nr_company bigint;
  _nr_branch  bigint;
  _nr_patient bigint;
  _nr_evol    bigint;
  _perm       jsonb;
  _vc_name    text;
  _text       text := left(nullif(trim(p_json ->> 'vc_text'), ''), 4000);
  _dh         timestamptz;
  _prof       bigint;
  _proc       bigint;
  _budget     bigint;
  _item       smallint;
  _block      jsonb;
  _set        od.branch_setting%rowtype;
  _minutes    smallint;
  _session    smallint;
  _done       boolean := false;
  _ret_days   smallint;
  _ret_date   date;
  _ret_name   text;
  _tz         text;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'clinical_evolution_save');
  if _action not in ('I', 'D') then
    raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_ACTION_INVALID');
  end if;
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('RECORD_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'PATIENTS');
  if _nr_user is null
     or (_action = 'I' and not ((_perm ->> 'id_create')::boolean or (_perm ->> 'id_update')::boolean))
     or (_action = 'D' and not (_perm ->> 'id_update')::boolean) then
    raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_FORBIDDEN');
  end if;
  _nr_patient := (p_json ->> 'nr_patient')::bigint;
  if _nr_patient is null then
    raise exception '%', ad.fn_message('PATIENT_REQUIRED');
  end if;
  select p.vc_name into _vc_name
    from od.patient p
   where p.nr_company = _nr_company and p.nr_branch = _nr_branch and p.nr_patient = _nr_patient
     for update;
  if not found then
    raise exception '%', ad.fn_message('PATIENT_NOT_FOUND');
  end if;

  if _action = 'D' then
    _nr_evol := (p_json ->> 'nr_evolution')::bigint;
    update od.clinical_evolution e set it_status = 90
     where e.nr_company = _nr_company and e.nr_branch = _nr_branch and e.nr_patient = _nr_patient
       and e.nr_evolution = _nr_evol and e.it_status = 1;
    if not found then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_NOT_FOUND');
    end if;
    -- desfaz a sessao (e a conclusao) do item do orcamento
    update od.budget_item i set dt_done = null, nr_evolution = null,
                                qt_sessions_done = greatest(0, i.qt_sessions_done - 1)
      from od.clinical_evolution e
     where e.nr_company = _nr_company and e.nr_branch = _nr_branch and e.nr_patient = _nr_patient
       and e.nr_evolution = _nr_evol and e.nr_budget is not null
       and i.nr_company = e.nr_company and i.nr_branch = e.nr_branch and i.nr_budget = e.nr_budget
       and i.nr_item = e.nr_item
       and exists (select 1 from od.budget b where b.nr_company = i.nr_company and b.nr_branch = i.nr_branch
                                               and b.nr_budget = i.nr_budget and b.nr_patient = _nr_patient);
    perform od.fn_stock_evolution(_nr_company, _nr_branch, _nr_patient, _nr_evol, _nr_user, true);
  else
    if _text is null then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_TEXT_REQUIRED');
    end if;
    -- pendencias do paciente no tratamento
    _block := od.fn_patient_block(_nr_company, _nr_branch, _nr_patient, 'TREAT');
    if (_block ->> 'it_rule')::smallint = 4 then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_BLOCKED',
        jsonb_build_object('Kind', lower(_block ->> 'vc_kind'), 'Amount', _block -> 'vl_total'));
    elsif (_block ->> 'it_rule')::smallint = 3 then
      if not private.fn_is_company_admin(_nr_company) then
        raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_APPROVAL',
          jsonb_build_object('Kind', lower(_block ->> 'vc_kind'), 'Amount', _block -> 'vl_total'));
      end if;
      if not coalesce((p_json ->> 'id_block_override')::boolean, false) then
        raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_CONFIRM',
          jsonb_build_object('Kind', lower(_block ->> 'vc_kind'), 'Amount', _block -> 'vl_total'));
      end if;
    end if;
    _block := case when (_block ->> 'it_rule')::smallint > 1
                   then jsonb_build_object('vc_kind', lower(_block ->> 'vc_kind'), 'qt_entries', _block -> 'qt_entries',
                                           'vl_total', _block -> 'vl_total') end;
    begin
      _dh     := coalesce((p_json ->> 'dh_evolution')::timestamptz, now());
      _prof   := (p_json ->> 'nr_professional')::bigint;
      _proc   := (p_json ->> 'nr_procedure')::bigint;
      _budget := (p_json ->> 'nr_budget')::bigint;
      _item   := (p_json ->> 'nr_item')::smallint;
    exception when others then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_VALUE_INVALID');
    end;
    if _dh > now() + interval '5 minutes' or (_budget is null) <> (_item is null) then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_VALUE_INVALID');
    end if;
    select * into _set from od.branch_setting s where s.nr_company = _nr_company and s.nr_branch = _nr_branch;
    if coalesce(_set.id_record_time, false) and p_json ? 'qt_minutes' and (p_json ->> 'qt_minutes') is not null then
      begin
        _minutes := (p_json ->> 'qt_minutes')::smallint;
      exception when others then
        raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_MINUTES_INVALID');
      end;
      if _minutes not between 1 and 600 then
        raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_MINUTES_INVALID');
      end if;
    end if;
    if _prof is not null and not exists (
         select 1 from od.professional r where r.nr_company = _nr_company and r.nr_branch = _nr_branch
                                           and r.nr_professional = _prof) then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_PROFESSIONAL_INVALID');
    end if;
    if _proc is not null and not exists (
         select 1 from od.procedure r where r.nr_company = _nr_company and r.nr_branch = _nr_branch
                                        and r.nr_procedure = _proc) then
      raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_PROCEDURE_INVALID');
    end if;
    if _budget is not null then
      perform 1
        from od.budget_item i
        join od.budget b on b.nr_company = i.nr_company and b.nr_branch = i.nr_branch and b.nr_budget = i.nr_budget
       where i.nr_company = _nr_company and i.nr_branch = _nr_branch and i.nr_budget = _budget and i.nr_item = _item
         and b.nr_patient = _nr_patient and b.it_status = 3 and i.dt_done is null
         for update of i;
      if not found then
        raise exception '%', ad.fn_message('CLINICAL_EVOLUTION_ITEM_INVALID');
      end if;
      if _proc is null then
        select i.nr_procedure into _proc from od.budget_item i
         where i.nr_company = _nr_company and i.nr_branch = _nr_branch and i.nr_budget = _budget and i.nr_item = _item;
      end if;
    end if;

    select coalesce(max(e.nr_evolution), 0) + 1 into _nr_evol
      from od.clinical_evolution e
     where e.nr_company = _nr_company and e.nr_branch = _nr_branch and e.nr_patient = _nr_patient;
    if _budget is not null then
      -- sessao: so com a configuracao ligada e item com mais de uma sessao
      select case when coalesce(_set.id_record_sessions, false) and i.qt_sessions > 1 then i.qt_sessions_done + 1 end,
             not coalesce(_set.id_record_sessions, false) or i.qt_sessions_done + 1 >= i.qt_sessions
        into _session, _done
        from od.budget_item i
       where i.nr_company = _nr_company and i.nr_branch = _nr_branch and i.nr_budget = _budget and i.nr_item = _item;
    else
      _done := _proc is not null;
    end if;
    insert into od.clinical_evolution (nr_company, nr_branch, nr_patient, nr_evolution, dh_evolution, nr_professional,
                                       vc_text, vc_tooth, nr_procedure, nr_budget, nr_item, nr_session, qt_minutes,
                                       nr_user, nr_operator)
    values (_nr_company, _nr_branch, _nr_patient, _nr_evol, _dh, _prof, _text,
            left(nullif(trim(p_json ->> 'vc_tooth'), ''), 40), _proc, _budget, _item, _session, _minutes,
            _nr_user, _nr_user);
    if _budget is not null then
      update od.budget_item i set
        qt_sessions_done = least(i.qt_sessions, i.qt_sessions_done + 1),
        dt_done          = case when _done then _dh::date else i.dt_done end,
        nr_evolution     = case when _done then _nr_evol else i.nr_evolution end
       where i.nr_company = _nr_company and i.nr_branch = _nr_branch and i.nr_budget = _budget and i.nr_item = _item;
    end if;
    -- retorno automatico do procedimento concluido
    if _done and _proc is not null and coalesce(_set.id_record_return, false) then
      select p.qt_return_days, p.vc_name into _ret_days, _ret_name
        from od.procedure p where p.nr_company = _nr_company and p.nr_branch = _nr_branch and p.nr_procedure = _proc;
      if _ret_days is not null then
        select b.vc_timezone into _tz from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch;
        _ret_date := (_dh at time zone _tz)::date + _ret_days;
        update od.patient p set dt_return_alert = _ret_date, vc_return_alert = left('Retorno: ' || _ret_name, 200)
         where p.nr_company = _nr_company and p.nr_branch = _nr_branch and p.nr_patient = _nr_patient
           and (p.dt_return_alert is null or p.dt_return_alert < (now() at time zone _tz)::date
                or p.dt_return_alert > _ret_date);
        if not found then
          _ret_date := null;
        end if;
      end if;
    end if;
    perform od.fn_stock_evolution(_nr_company, _nr_branch, _nr_patient, _nr_evol, _nr_user, false);
  end if;

  perform ad.fn_event_log(
    _nr_user, _nr_company, _nr_branch, 'PATIENTS', case when _action = 'I' then 'CREATE' else 'DELETE' end,
    'clinical_evolution', _nr_company::text || '/' || _nr_branch::text || '/' || _nr_patient::text || '/' || _nr_evol::text,
    format('Evolução %s no paciente %s', case when _action = 'I' then 'registrada' else 'excluída' end, _vc_name),
    jsonb_build_object('nr_patient', _nr_patient, 'nr_evolution', _nr_evol, 'nr_budget', _budget, 'nr_item', _item));

  return jsonb_build_object('nr_evolution', _nr_evol, 'nr_session', _session, 'id_item_done', _done and _budget is not null,
                            'dt_return_alert', _ret_date, 'block', _block);
end;
$$;

revoke all on function ad.clinical_evolution_save(jsonb) from public, anon;
grant execute on function ad.clinical_evolution_save(jsonb) to authenticated;
