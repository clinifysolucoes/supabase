/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.procedure_list(jsonb)                                      ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('procedure_list')        ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 14/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Procedimentos da filial com os materiais usados e o preco calculado no
    banco (od.fn_pricing_calc) a partir dos parametros da filial
    (od.fn_pricing_context). Comissao e lucro proprios do procedimento, quando
    informados, substituem os padroes. it_tax_regime permite simular o outro
    regime (PF x PJ) sem alterar os parametros. Alertas por procedimento:
      NO_TIME            tempo zero
      NO_MATERIAL        sem material e sem "outros materiais"
      MATERIAL_NO_PRICE  algum material usado esta sem preco
      PERCENT_TOO_HIGH   percentuais somam 100% ou mais (preco impossivel)
    Exige permissao de LEITURA na tela PRICING.

  Input p_json:
    nr_version           integer  obrigatorio = 1
    nr_company           bigint   obrigatorio
    nr_branch            bigint   obrigatorio
    id_include_inactive  boolean  opcional (default false)
    vc_search            text     opcional (codigo, nome ou categoria, contem)
    vc_category          text     opcional (categoria exata)
    it_tax_regime        integer  opcional 1 PF | 2 PJ (simulacao; default = parametro)

  Output jsonb:
    {"procedures": [{"nr_procedure", "vc_code", "vc_name", "vc_category", "qt_minutes",
                     "vl_lab_cost", "vl_material_other", "vl_current_price", "pc_commission",
                     "pc_profit", "it_status",
                     "materials": [{"nr_material", "vc_name", "vc_unit", "qt_used", "vl_unit_cost", "vl_line_cost"}],
                     "pricing": {... od.fn_pricing_calc ...},
                     "alerts": ["NO_TIME", ...]}],
     "categories": ["Clínica Geral", ...],
     "params": {...}, "summary": {...}}                         (od.fn_pricing_context)

  Errors: VERSION_MISMATCH, PRICING_BRANCH_REQUIRED, PRICING_FORBIDDEN, PROCEDURE_LIST_REGIME_INVALID
*/
create or replace function ad.procedure_list(p_json jsonb)
returns jsonb
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  _nr_company    bigint;
  _nr_branch     bigint;
  _inactive      boolean := coalesce((p_json ->> 'id_include_inactive')::boolean, false);
  _search        text    := nullif(trim(p_json ->> 'vc_search'), '');
  _category      text    := nullif(trim(p_json ->> 'vc_category'), '');
  _regime        smallint;
  _ctx           jsonb;
  _params        jsonb;
  _summary       jsonb;
  _pc_tax        numeric;
  _proc          record;
  _materials     jsonb;
  _vl_material   numeric;
  _qt_no_price   integer;
  _calc          jsonb;
  _alerts        jsonb;
  _procedures    jsonb := '[]'::jsonb;
  _categories    jsonb;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'procedure_list');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('PRICING_BRANCH_REQUIRED');
  end if;
  if not (ad.fn_screen_permission(_nr_company, _nr_branch, 'PRICING') ->> 'id_read')::boolean then
    raise exception '%', ad.fn_message('PRICING_FORBIDDEN');
  end if;

  _ctx     := od.fn_pricing_context(_nr_company, _nr_branch);
  _params  := _ctx -> 'params';
  _summary := _ctx -> 'summary';

  _regime := coalesce((p_json ->> 'it_tax_regime')::smallint, (_params ->> 'it_tax_regime')::smallint);
  if _regime not in (1, 2) then
    raise exception '%', ad.fn_message('PROCEDURE_LIST_REGIME_INVALID');
  end if;
  _pc_tax := case when _regime = 2 then (_params ->> 'pc_tax_pj')::numeric else (_params ->> 'pc_tax_pf')::numeric end;

  for _proc in
    select p.*
      from od.procedure p
     where p.nr_company = _nr_company
       and p.nr_branch  = _nr_branch
       and (_inactive or p.it_status = 1)
       and (_category is null or p.vc_category = _category)
       and (_search is null
            or p.vc_name ilike '%' || _search || '%'
            or coalesce(p.vc_code, '') ilike '%' || _search || '%'
            or coalesce(p.vc_category, '') ilike '%' || _search || '%')
     order by p.vc_category nulls last, p.vc_code nulls last, p.vc_name
  loop
    select coalesce(jsonb_agg(
             jsonb_build_object(
               'nr_material',  m.nr_material,
               'vc_name',      m.vc_name,
               'vc_unit',      m.vc_unit,
               'qt_used',      pm.qt_used,
               'vl_unit_cost', x.vl_unit_cost,
               'vl_line_cost', round(pm.qt_used * x.vl_unit_cost, 2))
             order by m.vc_name), '[]'::jsonb),
           coalesce(sum(round(pm.qt_used * x.vl_unit_cost, 2)), 0),
           count(*) filter (where x.vl_unit_cost = 0)
      into _materials, _vl_material, _qt_no_price
      from od.procedure_material pm
      join od.material m on m.nr_company  = pm.nr_company
                        and m.nr_branch   = pm.nr_branch
                        and m.nr_material = pm.nr_material
      cross join lateral (
        select round(m.vl_package_price / (m.qt_yield * (1 - m.pc_waste / 100)), 4) as vl_unit_cost
      ) x
     where pm.nr_company   = _proc.nr_company
       and pm.nr_branch    = _proc.nr_branch
       and pm.nr_procedure = _proc.nr_procedure;

    _vl_material := _vl_material + _proc.vl_material_other;

    _calc := od.fn_pricing_calc(jsonb_build_object(
      'vl_material',          _vl_material,
      'vl_lab',               _proc.vl_lab_cost,
      'qt_minutes',           _proc.qt_minutes,
      'vl_structure_hour',    _summary ->> 'vl_structure_hour',
      'vl_professional_hour', _params ->> 'vl_professional_hour',
      'pc_card',              _params ->> 'pc_card',
      'pc_commission',        coalesce(_proc.pc_commission, (_params ->> 'pc_commission')::numeric),
      'pc_fees',              _summary ->> 'pc_fees',
      'it_tax_regime',        _regime,
      'pc_tax',               _pc_tax,
      'pc_profit',            coalesce(_proc.pc_profit, (_params ->> 'pc_profit')::numeric)));

    _alerts := '[]'::jsonb;
    if _proc.qt_minutes = 0 then
      _alerts := _alerts || '"NO_TIME"'::jsonb;
    end if;
    if _vl_material = 0 then
      _alerts := _alerts || '"NO_MATERIAL"'::jsonb;
    end if;
    if _qt_no_price > 0 then
      _alerts := _alerts || '"MATERIAL_NO_PRICE"'::jsonb;
    end if;
    if not (_calc ->> 'id_valid')::boolean then
      _alerts := _alerts || '"PERCENT_TOO_HIGH"'::jsonb;
    end if;

    _procedures := _procedures || jsonb_build_object(
      'nr_procedure',      _proc.nr_procedure,
      'vc_code',           _proc.vc_code,
      'vc_name',           _proc.vc_name,
      'vc_category',       _proc.vc_category,
      'qt_minutes',        _proc.qt_minutes,
      'vl_lab_cost',       _proc.vl_lab_cost,
      'vl_material_other', _proc.vl_material_other,
      'vl_current_price',  _proc.vl_current_price,
      'pc_commission',     _proc.pc_commission,
      'pc_profit',         _proc.pc_profit,
      'it_status',         _proc.it_status,
      'materials',         _materials,
      'pricing',           _calc,
      'alerts',            _alerts);
  end loop;

  select coalesce(jsonb_agg(distinct p.vc_category order by p.vc_category), '[]'::jsonb)
    into _categories
    from od.procedure p
   where p.nr_company = _nr_company
     and p.nr_branch  = _nr_branch
     and p.vc_category is not null;

  return jsonb_build_object(
    'procedures', _procedures,
    'categories', _categories,
    'params',     _params,
    'summary',    _summary || jsonb_build_object('it_tax_regime', _regime, 'pc_tax', _pc_tax));
end;
$$;

revoke all on function ad.procedure_list(jsonb) from public, anon;
grant execute on function ad.procedure_list(jsonb) to authenticated;
