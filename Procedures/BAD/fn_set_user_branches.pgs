/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.fn_set_user_branches(bigint, bigint, jsonb, bigint)        ::
  ::  UsedBy      : company_user_save                                             ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 13/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Substitui os vinculos filial x perfil de um usuario numa empresa.
    p_branches = [{"nr_branch": 1, "nr_profile": 2}, ...] (obrigatorio, nao vazio).
    Valida que a filial pertence a empresa e que o perfil existe e esta ativo.
    Uso interno (a function chamadora ja validou que o operador e admin).
*/

create or replace function ad.fn_set_user_branches(
  p_nr_company  bigint,
  p_nr_user     bigint,
  p_branches    jsonb,
  p_nr_operator bigint
)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  _item       jsonb;
  _nr_branch  bigint;
  _nr_profile bigint;
begin
  if p_branches is null
     or jsonb_typeof(p_branches) <> 'array'
     or jsonb_array_length(p_branches) = 0 then
    raise exception '%', ad.fn_message('COMPANY_USER_BRANCHES_REQUIRED');
  end if;

  delete from ad.branch_user_profile bup
   where bup.nr_company = p_nr_company
     and bup.nr_user    = p_nr_user;

  for _item in select value from jsonb_array_elements(p_branches) loop
    _nr_branch  := (_item ->> 'nr_branch')::bigint;
    _nr_profile := (_item ->> 'nr_profile')::bigint;

    if _nr_branch is null or not exists (
         select 1 from ad.branch b
          where b.nr_company = p_nr_company and b.nr_branch = _nr_branch) then
      raise exception '%', ad.fn_message('COMPANY_USER_BRANCH_INVALID',
        jsonb_build_object('Branch', coalesce(_nr_branch::text, 'null')));
    end if;

    if _nr_profile is null or not exists (
         select 1 from ad.access_profile p
          where p.nr_company = p_nr_company and p.nr_profile = _nr_profile and p.it_status = 1) then
      raise exception '%', ad.fn_message('COMPANY_USER_PROFILE_INVALID',
        jsonb_build_object('Profile', coalesce(_nr_profile::text, 'null')));
    end if;

    insert into ad.branch_user_profile (nr_company, nr_branch, nr_user, nr_profile, nr_operator)
    values (p_nr_company, _nr_branch, p_nr_user, _nr_profile, p_nr_operator)
    on conflict do nothing;
  end loop;
end;
$$;

revoke all on function ad.fn_set_user_branches(bigint, bigint, jsonb, bigint) from public, anon, authenticated;
