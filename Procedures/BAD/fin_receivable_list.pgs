/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.fin_receivable_list(jsonb)                                 ::
  ::  UsedBy      : Flutter -> supabase.schema('ad').rpc('fin_receivable_list')   ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 04/11/2026                                                    ::
  ::  Change      : 05/11/2026 - dados do cartao e do cheque                     ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Recebiveis (cartao, boleto, cheque) com previsao no periodo (ate 400 dias),
    por situacao (pending = a receber, overdue = a receber com previsao antes de
    hoje, received, cancelled, all) e forma de pagamento; com paciente,
    descricao do lancamento, taxa e conta destino, e os totais bruto, taxa e
    liquido. Exige permissao de LEITURA na tela FINANCE.

  Input p_json:
    nr_version         integer  obrigatorio = 1
    nr_company         bigint   obrigatorio
    nr_branch          bigint   obrigatorio
    dt_from            date     obrigatorio (previsao)
    dt_to              date     obrigatorio (ate 400 dias)
    vc_status          text     opcional (padrao all)
    it_payment_method  integer  opcional

  Output jsonb:
    {"receivables": [{"nr_receivable", "nr_entry", "vc_description", "vc_patient", "it_payment_method",
                      "vc_rate", "nr_installment", "qt_installments", "vl_gross", "vl_fee", "vl_net",
                      "dt_expected", "nr_account", "vc_account", "it_status", "id_overdue",
                      "dt_received", "vl_received", "vc_reference", "vc_card_brand", "vc_card_last4",
                      "vc_authorization", "vc_holder_name", "vc_holder_document", "vc_bank_name",
                      "vc_check_number"}],
     "totals": {"vl_gross", "vl_fee", "vl_net", "vl_pending", "vl_received", "qt_total"},
     "dt_today"}

  Errors: VERSION_MISMATCH, FINANCE_BRANCH_REQUIRED, FINANCE_FORBIDDEN, FIN_LIST_FILTER_INVALID
*/
create or replace function ad.fin_receivable_list(p_json jsonb)
returns jsonb
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  _nr_company bigint;
  _nr_branch  bigint;
  _from       date;
  _to         date;
  _status     text := lower(coalesce(nullif(trim(p_json ->> 'vc_status'), ''), 'all'));
  _method     smallint;
  _today      date;
  _result     jsonb;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'fin_receivable_list');

  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('FINANCE_BRANCH_REQUIRED');
  end if;
  if not (ad.fn_screen_permission(_nr_company, _nr_branch, 'FINANCE') ->> 'id_read')::boolean then
    raise exception '%', ad.fn_message('FINANCE_FORBIDDEN');
  end if;
  begin
    _from   := (p_json ->> 'dt_from')::date;
    _to     := (p_json ->> 'dt_to')::date;
    _method := (p_json ->> 'it_payment_method')::smallint;
  exception when others then
    raise exception '%', ad.fn_message('FIN_LIST_FILTER_INVALID');
  end;
  if _from is null or _to is null or _to < _from or _to - _from > 400
     or _status not in ('pending', 'overdue', 'received', 'cancelled', 'all') then
    raise exception '%', ad.fn_message('FIN_LIST_FILTER_INVALID');
  end if;
  select (now() at time zone b.vc_timezone)::date into _today
    from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch;

  with base as (
    select r.*, (r.it_status = 1 and r.dt_expected < _today) as id_overdue
      from od.fin_receivable r
     where r.nr_company = _nr_company and r.nr_branch = _nr_branch
       and r.dt_expected between _from and _to
       and (_method is null or r.it_payment_method = _method)
       and case _status
             when 'pending' then r.it_status = 1
             when 'overdue' then r.it_status = 1 and r.dt_expected < _today
             when 'received' then r.it_status = 2
             when 'cancelled' then r.it_status = 90
             else true
           end
     order by r.dt_expected, r.nr_receivable
     limit 1000
  )
  select jsonb_build_object(
           'receivables', coalesce(jsonb_agg(jsonb_build_object(
                            'nr_receivable', b.nr_receivable, 'nr_entry', b.nr_entry,
                            'vc_description', e.vc_description, 'vc_patient', p.vc_name,
                            'it_payment_method', b.it_payment_method, 'vc_rate', cr.vc_name,
                            'nr_installment', b.nr_installment, 'qt_installments', b.qt_installments,
                            'vl_gross', b.vl_gross, 'vl_fee', b.vl_fee, 'vl_net', b.vl_net,
                            'dt_expected', b.dt_expected, 'nr_account', b.nr_account, 'vc_account', a.vc_name,
                            'it_status', b.it_status, 'id_overdue', b.id_overdue,
                            'dt_received', b.dt_received, 'vl_received', b.vl_received,
                            'vc_reference', b.vc_reference,
                            'vc_card_brand', b.vc_card_brand, 'vc_card_last4', b.vc_card_last4,
                            'vc_authorization', b.vc_authorization, 'vc_holder_name', b.vc_holder_name,
                            'vc_holder_document', b.vc_holder_document, 'vc_bank_name', b.vc_bank_name,
                            'vc_check_number', b.vc_check_number)
                            order by b.dt_expected, b.nr_receivable), '[]'::jsonb),
           'totals', jsonb_build_object(
                       'vl_gross', coalesce(sum(b.vl_gross) filter (where b.it_status <> 90), 0),
                       'vl_fee', coalesce(sum(b.vl_fee) filter (where b.it_status <> 90), 0),
                       'vl_net', coalesce(sum(b.vl_net) filter (where b.it_status <> 90), 0),
                       'vl_pending', coalesce(sum(b.vl_net) filter (where b.it_status = 1), 0),
                       'vl_received', coalesce(sum(b.vl_received) filter (where b.it_status = 2), 0),
                       'qt_total', count(*)),
           'dt_today', _today)
    into _result
    from base b
    join od.fin_entry e on e.nr_company = b.nr_company and e.nr_branch = b.nr_branch and e.nr_entry = b.nr_entry
    left join od.patient p on p.nr_company = e.nr_company and p.nr_branch = e.nr_branch and p.nr_patient = e.nr_patient
    left join od.fin_card_rate cr on cr.nr_company = b.nr_company and cr.nr_branch = b.nr_branch and cr.nr_rate = b.nr_rate
    join od.fin_account a on a.nr_company = b.nr_company and a.nr_branch = b.nr_branch and a.nr_account = b.nr_account;

  return _result;
end;
$$;

revoke all on function ad.fin_receivable_list(jsonb) from public, anon;
grant execute on function ad.fin_receivable_list(jsonb) to authenticated;
