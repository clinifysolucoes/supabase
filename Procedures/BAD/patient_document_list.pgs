/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.patient_document_list(jsonb)                               ::
  ::  UsedBy      : Flutter -> rpc('patient_document_list') (documentos)          ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 07/11/2026                                                    ::
  ::  Change      : 08/11/2026 - qt_signatures (assinatura eletronica)            ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Documentos emitidos do paciente (LER na tela PATIENTS), mais recentes
    primeiro, com os medicamentos do receituario, o paciente e o emitente
    (dados da clinica) para gerar o PDF.

  Input p_json:
    nr_version  integer  obrigatorio = 1
    nr_company, nr_branch, nr_patient  bigint  obrigatorios

  Output jsonb:
    {"documents": [{"nr_document", "it_kind", "nr_template", "vc_title", "vc_body", "dt_document",
                    "nr_professional", "vc_professional", "vc_council", "vc_user", "dh_created", "qt_signatures",
                    "items": [{"nr_item", "nr_medication", "vc_name", "vc_presentation", "vc_dosage",
                               "vc_quantity", "it_use", "id_controlled"}]}],
     "patient": {"vc_name", "vc_cpf", "dt_birth", "vc_address"},
     "issuer": {... como em ad.budget_get},
     "permission": {"id_create", "id_update"}}

  Errors: VERSION_MISMATCH, RECORD_BRANCH_REQUIRED, RECORD_FORBIDDEN, PATIENT_REQUIRED, PATIENT_NOT_FOUND
*/
create or replace function ad.patient_document_list(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _nr_patient bigint;
  _perm       jsonb;
  _p          od.patient;
  _br         ad.branch;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'patient_document_list');
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('RECORD_BRANCH_REQUIRED');
  end if;
  _nr_user := private.fn_current_user_nr();
  _perm    := ad.fn_screen_permission(_nr_company, _nr_branch, 'PATIENTS');
  if _nr_user is null or not coalesce((_perm ->> 'id_read')::boolean, false) then
    raise exception '%', ad.fn_message('RECORD_FORBIDDEN');
  end if;
  _nr_patient := (p_json ->> 'nr_patient')::bigint;
  if _nr_patient is null then
    raise exception '%', ad.fn_message('PATIENT_REQUIRED');
  end if;
  select * into _p from od.patient p
   where p.nr_company = _nr_company and p.nr_branch = _nr_branch and p.nr_patient = _nr_patient;
  if not found then
    raise exception '%', ad.fn_message('PATIENT_NOT_FOUND');
  end if;
  select * into _br from ad.branch b where b.nr_company = _nr_company and b.nr_branch = _nr_branch;

  return jsonb_build_object(
    'documents', coalesce((
      select jsonb_agg(jsonb_build_object(
               'nr_document', d.nr_document, 'it_kind', d.it_kind, 'nr_template', d.nr_template,
               'vc_title', d.vc_title, 'vc_body', d.vc_body, 'dt_document', d.dt_document,
               'nr_professional', d.nr_professional, 'vc_professional', pr.vc_name, 'vc_council', pr.vc_council,
               'vc_user', u.vc_name, 'dh_created', d.dh_created,
               'qt_signatures', (select count(*) from od.signature g where g.nr_company = d.nr_company and g.nr_branch = d.nr_branch
                                   and g.nr_patient = d.nr_patient and g.nr_document = d.nr_document),
               'items', coalesce((select jsonb_agg(jsonb_build_object(
                    'nr_item', i.nr_item, 'nr_medication', i.nr_medication, 'vc_name', i.vc_name,
                    'vc_presentation', i.vc_presentation, 'vc_dosage', i.vc_dosage, 'vc_quantity', i.vc_quantity,
                    'it_use', i.it_use, 'id_controlled', i.id_controlled) order by i.nr_item)
                  from od.patient_document_item i
                 where i.nr_company = d.nr_company and i.nr_branch = d.nr_branch and i.nr_patient = d.nr_patient
                   and i.nr_document = d.nr_document), '[]'::jsonb))
             order by d.dt_document desc, d.nr_document desc)
        from od.patient_document d
        left join od.professional pr on pr.nr_company = d.nr_company and pr.nr_branch = d.nr_branch
                                    and pr.nr_professional = d.nr_professional
        left join ad.app_user u on u.nr_user = d.nr_user
       where d.nr_company = _nr_company and d.nr_branch = _nr_branch and d.nr_patient = _nr_patient
         and d.it_status = 1), '[]'::jsonb),
    'patient', jsonb_build_object(
      'vc_name', _p.vc_name, 'vc_cpf', _p.vc_cpf, 'dt_birth', _p.dt_birth,
      'vc_address', nullif(concat_ws(', ', _p.vc_address, _p.vc_address_number, _p.vc_address_complement, _p.vc_district,
                                     nullif(concat_ws('/', _p.vc_city, _p.vc_state), '')), '')),
    'issuer', jsonb_build_object(
      'vc_name', _br.vc_name, 'vc_legal_name', _br.vc_legal_name, 'vc_cnpj', _br.vc_cnpj,
      'vc_phone', _br.vc_phone, 'vc_email', _br.vc_email, 'vc_zip_code', _br.vc_zip_code,
      'vc_address', _br.vc_address, 'vc_address_number', _br.vc_address_number,
      'vc_address_extra', _br.vc_address_extra, 'vc_district', _br.vc_district, 'vc_city', _br.vc_city,
      'vc_state', _br.vc_state, 'vc_technical_name', _br.vc_technical_name,
      'vc_technical_cro', _br.vc_technical_cro, 'vc_technical_cro_state', _br.vc_technical_cro_state),
    'permission', jsonb_build_object(
      'id_create', coalesce((_perm ->> 'id_create')::boolean, false) or coalesce((_perm ->> 'id_update')::boolean, false),
      'id_update', coalesce((_perm ->> 'id_update')::boolean, false)));
end;
$$;

revoke all on function ad.patient_document_list(jsonb) from public, anon;
grant execute on function ad.patient_document_list(jsonb) to authenticated;
