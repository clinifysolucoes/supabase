/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.fn_cnpj_is_valid(text)                                     ::
  ::  UsedBy      : company_create, company_update, branch_create, branch_update  ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 13/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Valida os digitos verificadores do CNPJ. Aceita o CNPJ alfanumerico
    (Receita Federal, a partir de 07/2026): 12 posicoes [A-Z0-9] + 2 digitos.
    Cada caractere entra no calculo com (codigo ASCII - 48), que para digitos
    e o proprio valor numerico. Pontuacao e removida; letras vao para maiusculo.
*/

create or replace function ad.fn_cnpj_is_valid(p_vc_cnpj text)
returns boolean
language plpgsql
immutable
set search_path = ''
as $$
declare
  _s   text;
  _sum integer;
  _dv1 integer;
  _dv2 integer;
  _i   integer;
  _w1  integer[] := array[5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
  _w2  integer[] := array[6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3];
begin
  _s := upper(regexp_replace(coalesce(p_vc_cnpj, ''), '[^A-Za-z0-9]', '', 'g'));

  if _s !~ '^[A-Z0-9]{12}[0-9]{2}$' then
    return false;
  end if;
  if _s ~ '^(.)\1{13}$' then
    return false;
  end if;

  _sum := 0;
  for _i in 1..12 loop
    _sum := _sum + (ascii(substr(_s, _i, 1)) - 48) * _w1[_i];
  end loop;
  _dv1 := 11 - (_sum % 11);
  if _dv1 >= 10 then _dv1 := 0; end if;

  _sum := 0;
  for _i in 1..12 loop
    _sum := _sum + (ascii(substr(_s, _i, 1)) - 48) * _w2[_i];
  end loop;
  _sum := _sum + _dv1 * 2;
  _dv2 := 11 - (_sum % 11);
  if _dv2 >= 10 then _dv2 := 0; end if;

  return substr(_s, 13, 1)::integer = _dv1
     and substr(_s, 14, 1)::integer = _dv2;
end;
$$;

revoke all on function ad.fn_cnpj_is_valid(text) from public, anon, authenticated;
