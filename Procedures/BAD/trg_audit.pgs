/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative                                           ::
  ::  Object      : ad.trg_audit() + triggers *_audit em todas as tabelas         ::
  ::  UsedBy      : Postgres (BEFORE INSERT OR UPDATE)                            ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : Jose Carlos de Oliveira Junior                                ::
  ::  Date        : 13/10/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Preenche as colunas de auditoria padrao sem depender de cada function lembrar:
      nr_operator  usuario logado (private.fn_current_user_nr) ou o informado
      dh_created   fixado no INSERT, nunca muda
      dh_updated   now() a cada INSERT/UPDATE
    Toda tabela nova do schema ad DEVE receber o trigger <tabela>_audit aqui.
*/

create or replace function ad.trg_audit()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  if tg_op = 'INSERT' then
    new.dh_created  := now();
    new.dh_updated  := now();
    new.nr_operator := coalesce(new.nr_operator, private.fn_current_user_nr());
  else
    new.dh_created  := old.dh_created;
    new.dh_updated  := now();
    new.nr_operator := coalesce(private.fn_current_user_nr(), new.nr_operator);
  end if;
  return new;
end;
$$;

revoke all on function ad.trg_audit() from public, anon, authenticated;

create or replace trigger company_audit
  before insert or update on ad.company
  for each row execute function ad.trg_audit();

create or replace trigger branch_audit
  before insert or update on ad.branch
  for each row execute function ad.trg_audit();

create or replace trigger app_user_audit
  before insert or update on ad.app_user
  for each row execute function ad.trg_audit();

create or replace trigger access_profile_audit
  before insert or update on ad.access_profile
  for each row execute function ad.trg_audit();

create or replace trigger company_user_audit
  before insert or update on ad.company_user
  for each row execute function ad.trg_audit();

create or replace trigger branch_user_profile_audit
  before insert or update on ad.branch_user_profile
  for each row execute function ad.trg_audit();

create or replace trigger access_log_audit
  before insert or update on ad.access_log
  for each row execute function ad.trg_audit();

create or replace trigger screen_audit
  before insert or update on ad.screen
  for each row execute function ad.trg_audit();

create or replace trigger access_profile_screen_audit
  before insert or update on ad.access_profile_screen
  for each row execute function ad.trg_audit();

create or replace trigger event_log_audit
  before insert or update on ad.event_log
  for each row execute function ad.trg_audit();
