/*::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  ::  Project     : Supabase multi-company login (base do futuro sistema odonto)  ::
  ::  Schema      : AD - Administrative (RPC exposta; dados no schema od)         ::
  ::  Object      : ad.chart_model_list(jsonb)                                    ::
  ::  UsedBy      : Flutter -> rpc('chart_model_list') (prontuario/Configuracoes) ::
  ::----------------------------------------------------------------------------::
  ::  Programmer  : clinifysolucoes                                               ::
  ::  Date        : 13/11/2026                                                    ::
  ::  Change      : First version                                                 ::
  ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  Description:
    Modelos de ficha por especialidade da filial com os campos (LER em
    PATIENTS ou SETTINGS). Na primeira chamada cria os modelos prontos
    (od.fn_chart_default). Inativos so com id_inactive.

  Input p_json:
    nr_version   integer  obrigatorio = 1
    nr_company, nr_branch  bigint  obrigatorios
    id_inactive  boolean  opcional (inclui os inativos)

  Output jsonb:
    {"models": [{"nr_model", "vc_name", "nr_specialty", "vc_specialty", "id_per_tooth", "it_status",
                 "fields": [{"nr_field", "vc_label", "it_type", "vc_options", "vc_unit", "id_required"}]}],
     "permission": {"id_update"}}

  Errors: VERSION_MISMATCH, RECORD_BRANCH_REQUIRED, RECORD_FORBIDDEN
*/
create or replace function ad.chart_model_list(p_json jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  _nr_user    bigint;
  _nr_company bigint;
  _nr_branch  bigint;
  _inactive   boolean := coalesce((p_json ->> 'id_inactive')::boolean, false);
  _settings   jsonb;
begin
  perform ad.fn_check_version((p_json ->> 'nr_version')::integer, 1, 'chart_model_list');
  _nr_company := (p_json ->> 'nr_company')::bigint;
  _nr_branch  := (p_json ->> 'nr_branch')::bigint;
  if _nr_company is null or _nr_branch is null then
    raise exception '%', ad.fn_message('RECORD_BRANCH_REQUIRED');
  end if;
  _nr_user  := private.fn_current_user_nr();
  _settings := ad.fn_screen_permission(_nr_company, _nr_branch, 'SETTINGS');
  if _nr_user is null
     or not (coalesce((ad.fn_screen_permission(_nr_company, _nr_branch, 'PATIENTS') ->> 'id_read')::boolean, false)
             or coalesce((_settings ->> 'id_read')::boolean, false)) then
    raise exception '%', ad.fn_message('RECORD_FORBIDDEN');
  end if;

  perform od.fn_chart_default(_nr_company, _nr_branch, _nr_user);

  return jsonb_build_object(
    'models', coalesce((
      select jsonb_agg(jsonb_build_object(
               'nr_model', m.nr_model, 'vc_name', m.vc_name, 'nr_specialty', m.nr_specialty,
               'vc_specialty', s.vc_name, 'id_per_tooth', m.id_per_tooth, 'it_status', m.it_status,
               'fields', coalesce((select jsonb_agg(jsonb_build_object(
                    'nr_field', f.nr_field, 'vc_label', f.vc_label, 'it_type', f.it_type,
                    'vc_options', f.vc_options, 'vc_unit', f.vc_unit, 'id_required', f.id_required)
                    order by f.nr_field)
                  from od.chart_field f
                 where f.nr_company = m.nr_company and f.nr_branch = m.nr_branch and f.nr_model = m.nr_model), '[]'::jsonb))
             order by m.vc_name, m.nr_model)
        from od.chart_model m
        left join od.specialty s on s.nr_company = m.nr_company and s.nr_branch = m.nr_branch
                                and s.nr_specialty = m.nr_specialty
       where m.nr_company = _nr_company and m.nr_branch = _nr_branch
         and (_inactive or m.it_status = 1)), '[]'::jsonb),
    'permission', jsonb_build_object('id_update', coalesce((_settings ->> 'id_update')::boolean, false)));
end;
$$;

revoke all on function ad.chart_model_list(jsonb) from public, anon;
grant execute on function ad.chart_model_list(jsonb) to authenticated;
