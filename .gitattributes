# Normaliza fim de linha: tudo LF no repositorio e no checkout.
# Scripts .sh com CRLF quebram no runner Linux do GitHub Actions; .pgs/.sql com
# CRLF mudam o checksum do Flyway entre Windows e Linux.
* text=auto eol=lf
*.sh   text eol=lf
*.pgs  text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.html text eol=lf
*.conf text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.ico  binary
